    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "二時以降は出ない。",
    "synthesis_text": "にじいこうワでない。",
    "start": 152.745,
    "end": 154.542,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v046_ミナ.wav"
  },
  {
    "id": "ep01_v047",
    "cut": "ep01_037",
    "character": "タクミ",
