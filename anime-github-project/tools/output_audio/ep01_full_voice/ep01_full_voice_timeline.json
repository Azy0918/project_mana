    "end": 107.54,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v032_ナレーション.wav"
  },
  {
    "id": "ep01_v033",
    "cut": "ep01_028",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "製造年月日、二〇七四年六月十二日。",
    "synthesis_text": "せいぞうねんがっぴ、にせんななじゅうよねんろくがつじゅうににち。",
