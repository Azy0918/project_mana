    "character": "タクミ",
    "speaker_name": "にせ",
    "style_name": "ノーマル",
    "style_id": 1937616896,
    "text": "地獄が給与明細に出るタイプだ。",
    "synthesis_text": "じごくがきゅうよめいさいにでるたいぷだ。",
