    "cut": "ep01_009",
    "character": "タクミ",
    "speaker_name": "にせ",
    "style_name": "ノーマル",
    "style_id": 1937616896,
    "text": "現実的に深いですね。",
    "synthesis_text": "げんじつてきにふかいですね。",
    "start": 32.549,
    "end": 34.757,
    "pause_after_ms": 250,
