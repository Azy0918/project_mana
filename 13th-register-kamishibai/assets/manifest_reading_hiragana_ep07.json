[
  { "id": "ep07_v001", "cut": "ep07_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時十四分。宅配便の端末が勝手に鳴った。", "synthesis_text": "ごぜんにじじゅうよんぷん。たくはいびんのたんまつがかってになった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v001_ナレーション.wav" },
  { "id": "ep07_v002", "cut": "ep07_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "配達予定なし。だがカウンターの下に、銀色の箱が置かれている。", "synthesis_text": "はいたつよていなし。だがかうんたーのしたに、ぎんいろのはこがおかれている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v002_ナレーション.wav" },
  { "id": "ep07_v003", "cut": "ep07_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ラベルには、月面基地南七番区画、店留め、とあった。", "synthesis_text": "らべるにワ、げつめんきちみなみななばんくかく、みせどめ、とあった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v003_ナレーション.wav" },
  { "id": "ep07_v004", "cut": "ep07_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "エリさん、月面の荷物が店留めです", "synthesis_text": "みなさん、げつめんのにもつがみせどめです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v004_タクミ.wav" },
  { "id": "ep07_v005", "cut": "ep07_vc02", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "受取番号は？", "synthesis_text": "うけとりばんごうワ？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v005_エリ.wav" },
  { "id": "ep07_v006", "cut": "ep07_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "そこから入るんですか", "synthesis_text": "そこからハいるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v006_タクミ.wav" },
  { "id": "ep07_v007", "cut": "ep07_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れ、銀色の箱を読み取った。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれ、ぎんいろのはこをよみとった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v007_ナレーション.wav" },
  { "id": "ep07_v008", "cut": "ep07_vc03", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "宇宙宅配便を確認。宛先、月面基地。誤配先、現代日本地方都市コンビニ", "synthesis_text": "うちゅうたくはいびんをかくにん。あてさき、げつめんきち。ごはいさき、げんだいにほんちほうとしこんびに。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v008_第十三レジ.wav" },
  { "id": "ep07_v009", "cut": "ep07_vc03", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "スケールの違いが伝票一枚に収まってる", "synthesis_text": "すけーるのちがいが、でんぴょういちまいにおさまってる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v009_タクミ.wav" },
  { "id": "ep07_v010", "cut": "ep07_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "箱の中には、無重力プリン、月面作業員用カップ麺、真空でも鳴る防犯ブザーが入っていた。", "synthesis_text": "はこのなかにワ、むじゅうりょくぷりん、げつめんさぎょういんようかっぷめん、しんくうでもなるぼうはんぶざーがハいっていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v010_ナレーション.wav" },
  { "id": "ep07_v011", "cut": "ep07_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリはプリンを見た。", "synthesis_text": "みなワ、ぷりんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v011_ナレーション.wav" },
  { "id": "ep07_v012", "cut": "ep07_vc04", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "食べられる？", "synthesis_text": "たべられる？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v012_エリ.wav" },
  { "id": "ep07_v013", "cut": "ep07_vc04", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "重力下では跳ねます", "synthesis_text": "じゅうりょくかでワ、はねます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v013_第十三レジ.wav" },
  { "id": "ep07_v014", "cut": "ep07_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "食べ物として致命的", "synthesis_text": "たべものとして、ちめいてき。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v014_タクミ.wav" },
  { "id": "ep07_v015", "cut": "ep07_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田がナビ端末を持って現れた。", "synthesis_text": "あせだがなびたんまつをもってあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v015_ナレーション.wav" },
  { "id": "ep07_v016", "cut": "ep07_vc05", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "銀河流通監査局のラベルだ", "synthesis_text": "ぎんがりゅうつうかんさきょくのらべるだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v016_汗田竜司.wav" },
  { "id": "ep07_v017", "cut": "ep07_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "なんですか、それ", "synthesis_text": "なんですか、それ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v017_タクミ.wav" },
  { "id": "ep07_v018", "cut": "ep07_vc05", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "侵略者ではない。銀河規模の物流監査組織だ。たぶん、かなり事務的な連中だ", "synthesis_text": "しんりゃくしゃでワない。ぎんがきぼのぶつりゅうかんさそしきだ。たぶん、かなりじむてきなれんちゅうだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v018_汗田竜司.wav" },
  { "id": "ep07_v019", "cut": "ep07_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "その説明を待っていたように、コピー機が起動した。", "synthesis_text": "そのせつめいをまっていたように、こぴーきがきどうした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v019_ナレーション.wav" },
  { "id": "ep07_v020", "cut": "ep07_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ウィーン。", "synthesis_text": "うぃーん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v020_ナレーション.wav" },
  { "id": "ep07_v021", "cut": "ep07_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "銀河流通監査局、通知。指摘事項。", "synthesis_text": "ぎんがりゅうつうかんさきょく、つうち。してきじこう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v021_ナレーション.wav" },
  { "id": "ep07_v022", "cut": "ep07_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "一、店留め荷物は本人確認を徹底すること。二、月面重力差額は返金対象外。三、店内BGMが銀河基準より眠い。", "synthesis_text": "いち、みせどめにもつワ、ほんにんかくにんをてっていすること。に、げつめんじゅうりょくさがくワ、へんきんたいしょうがい。さん、てんないびーじーえむがぎんがきじゅんよりねむい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v022_ナレーション.wav" },
  { "id": "ep07_v023", "cut": "ep07_vc07", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "最後いります？", "synthesis_text": "さいごいります？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v023_タクミ.wav" },
  { "id": "ep07_v024", "cut": "ep07_vc07", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "眠いのは事実", "synthesis_text": "ねむいのワ、じじつ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v024_エリ.wav" },
  { "id": "ep07_v025", "cut": "ep07_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そこへ座木山が来た。", "synthesis_text": "そこエ、ざきやまがきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v025_ナレーション.wav" },
  { "id": "ep07_v026", "cut": "ep07_vc08", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "コピー、使えるかい。月面の地図でも出る？", "synthesis_text": "こぴー、つかえるかい。げつめんのちずでもでる？", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v026_座木山辰哉.wav" },
  { "id": "ep07_v027", "cut": "ep07_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "今まさに月面の荷物が来てます", "synthesis_text": "いままさに、げつめんのにもつがきてます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v027_タクミ.wav" },
  { "id": "ep07_v028", "cut": "ep07_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "座木山は箱を見た。", "synthesis_text": "ざきやまワ、はこをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v028_ナレーション.wav" },
  { "id": "ep07_v029", "cut": "ep07_vc09", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "月面？　道、舗装されてるのかい", "synthesis_text": "げつめん？　みち、ほそうされてるのかい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v029_座木山辰哉.wav" },
  { "id": "ep07_v030", "cut": "ep07_vc09", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ツーリング前提で見ないでください", "synthesis_text": "つーりんぐぜんていで、みないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v030_タクミ.wav" },
  { "id": "ep07_v031", "cut": "ep07_vc10", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "受取人確認が必要です", "synthesis_text": "うけとりにんかくにんがひつようです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v031_第十三レジ.wav" },
  { "id": "ep07_v032", "cut": "ep07_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは端末を見た。", "synthesis_text": "たくみワ、たんまつをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v032_ナレーション.wav" },
  { "id": "ep07_v033", "cut": "ep07_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "受取人名、月面店 夜勤担当。本人確認書類、クレーター作業許可証、銀河共通社員証、またはレシート。", "synthesis_text": "うけとりにんめい、げつめんてん、やきんたんとう。ほんにんかくにんしょるい、くれーたーさぎょうきょかしょう、ぎんがきょうつうしゃいんしょう、またワれしーと。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v033_ナレーション.wav" },
  { "id": "ep07_v034", "cut": "ep07_vc10", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "またレシートで本人確認しようとしてる", "synthesis_text": "また、れしーとでほんにんかくにんしようとしてる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v034_タクミ.wav" },
  { "id": "ep07_v035", "cut": "ep07_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は箱の配送ログを開いた。", "synthesis_text": "あせだワ、はこのはいそうろぐをひらいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v035_ナレーション.wav" },
  { "id": "ep07_v036", "cut": "ep07_vc11", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "これは本来、月面店舗の補給品だ。だが配送経路に、未来青年の封印タグと同じ署名がある", "synthesis_text": "これワ、ほんらい、げつめんてんぽのほきゅうひんだ。だがはいそうけいろに、みらいせいねんのふういんたぐとおなじしょめいがある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v036_汗田竜司.wav" },
  { "id": "ep07_v037", "cut": "ep07_vc11", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "またあの人ですか", "synthesis_text": "またあのひとですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v037_タクミ.wav" },
  { "id": "ep07_v038", "cut": "ep07_vc11", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "危険知識保持者の物流経路と一部一致", "synthesis_text": "きけんちしきほじしゃのぶつりゅうけいろと、いちぶいっち。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v038_第十三レジ.wav" },
  { "id": "ep07_v039", "cut": "ep07_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは受取欄を見た。", "synthesis_text": "みなワ、うけとりらんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v039_ナレーション.wav" },
  { "id": "ep07_v040", "cut": "ep07_vc12", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "本人がいないなら再配送", "synthesis_text": "ほんにんがいないなら、さいはいそう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v040_エリ.wav" },
  { "id": "ep07_v041", "cut": "ep07_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "宇宙にも再配送あるんですか", "synthesis_text": "うちゅうにも、さいはいそうあるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v041_タクミ.wav" },
  { "id": "ep07_v042", "cut": "ep07_vc12", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "荷物だから", "synthesis_text": "にもつだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v042_エリ.wav" },
  { "id": "ep07_v043", "cut": "ep07_vc13", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "再配送処理には、店留め保管料が必要です", "synthesis_text": "さいはいそうしょりにワ、みせどめほかんりょうがひつようです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v043_第十三レジ.wav" },
  { "id": "ep07_v044", "cut": "ep07_vc13", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "宇宙からも取るんですね", "synthesis_text": "うちゅうからも、とるんですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v044_タクミ.wav" },
  { "id": "ep07_v045", "cut": "ep07_vc13", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "保管したから", "synthesis_text": "ほかんしたから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v045_エリ.wav" },
  { "id": "ep07_v046", "cut": "ep07_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは箱に再配送ラベルを貼った。", "synthesis_text": "たくみワ、はこにさいはいそうらべるをはった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v046_ナレーション.wav" },
  { "id": "ep07_v047", "cut": "ep07_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "宛先は月面基地。備考欄には、こちらではプリンが跳ねます、と書いた。", "synthesis_text": "あてさきワ、げつめんきち。びこうらんにワ、こちらでワぷりんがはねます、とかいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v047_ナレーション.wav" },
  { "id": "ep07_v048", "cut": "ep07_vc14", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "再配送を受理しました。銀河流通監査局へ通知します", "synthesis_text": "さいはいそうをじゅりしました。ぎんがりゅうつうかんさきょくエ、つうちします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v048_第十三レジ.wav" },
  { "id": "ep07_v049", "cut": "ep07_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "レシートが出た。", "synthesis_text": "れしーとがでた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v049_ナレーション.wav" },
  { "id": "ep07_v050", "cut": "ep07_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "座木山はコピー機から出た月面地図を眺めた。", "synthesis_text": "ざきやまワ、こぴーきからでたげつめんちずをながめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v050_ナレーション.wav" },
  { "id": "ep07_v051", "cut": "ep07_vc16", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "この道、夜は暗そうだな", "synthesis_text": "このみち、よるワくらそうだな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v051_座木山辰哉.wav" },
  { "id": "ep07_v052", "cut": "ep07_vc16", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "月ですからね", "synthesis_text": "つきですからね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v052_タクミ.wav" },
  { "id": "ep07_v053", "cut": "ep07_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリはタクミのマニュアルを見た。", "synthesis_text": "みなワ、たくみのまにゅあるをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v053_ナレーション.wav" },
  { "id": "ep07_v054", "cut": "ep07_vc17", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "書く？", "synthesis_text": "かく？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v054_エリ.wav" },
  { "id": "ep07_v055", "cut": "ep07_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはため息をついた。", "synthesis_text": "たくみワ、ためいきをついた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v055_ナレーション.wav" },
  { "id": "ep07_v056", "cut": "ep07_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "宇宙宅配便も受取番号が必要。月面でも店留めは店留め。", "synthesis_text": "うちゅうたくはいびんも、うけとりばんごうがひつよう。げつめんでも、みせどめワみせどめ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v056_ナレーション.wav" },
  { "id": "ep07_v057", "cut": "ep07_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "外では国道をトラックが一台通り過ぎた。", "synthesis_text": "そとでワ、こくどうをとらっくがいちだいとおりすぎた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v057_ナレーション.wav" },
  { "id": "ep07_v058", "cut": "ep07_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "地球の物流は、今日も普通に動いていた。", "synthesis_text": "ちきゅうのぶつりゅうワ、きょうもふつうにうごいていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep07_voice_reading_hiragana\\clips\\ep07_v058_ナレーション.wav" }
]
