  },
  {
    "id": "ep01_v005",
    "cut": "ep01_006",
    "character": "ミナ",
    "speaker": "ほのか(~現実20代女子AIボイチェン~リアボVC公式モデル) / ノーマル",
    "text": "食べていいとは言ってない。",
    "synthesis_text": "たべていいとはいってない。",
