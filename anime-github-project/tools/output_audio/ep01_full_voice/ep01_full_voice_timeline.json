    "end": 103.179,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v031_ナレーション.wav"
  },
  {
    "id": "ep01_v032",
    "cut": "ep01_028",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "パッケージには、完全栄養おにぎり・思い出の鮭。",
    "synthesis_text": "ぱっけーじにワ、かんぜんえいようおにぎり、おもいでのしゃけ。",
