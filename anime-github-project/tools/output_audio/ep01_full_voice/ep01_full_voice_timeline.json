  },
  {
    "id": "ep01_v041",
    "cut": "ep01_034",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "説得力が嫌だ。",
    "synthesis_text": "せっとくりょくがいやだ。",
    "start": 137.077,
    "end": 138.81,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v041_タクミ.wav"
  },
  {
    "id": "ep01_v042",
    "cut": "ep01_036",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "第十三レジの画面には、通常返品、時空返品、存在取消、温める、店長呼出、と並んでいた。",
    "synthesis_text": "だいじゅうさんれじのがめんにワ、つうじょうへんぴん、じくうへんぴん、そんざいとりけし、あたためる、てんちょうよびだし、とならんでいた。",
    "start": 139.36,
    "end": 147.789,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v042_ナレーション.wav"
  },
  {
    "id": "ep01_v043",
    "cut": "ep01_037",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "店長呼出があります。",
    "synthesis_text": "てんちょうよびだしがあります。",
    "start": 148.139,
    "end": 149.881,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v043_タクミ.wav"
  },
  {
    "id": "ep01_v044",
    "cut": "ep01_038",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "押さない。",
    "synthesis_text": "おさない。",
    "start": 150.081,
    "end": 151.32,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v044_ミナ.wav"
  },
  {
