  {
    "id": "ep01_v002",
    "cut": "ep01_002",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "国道沿いのコンビニは、冷蔵ケースの低い音だけでできているみたいに静かだった。",
    "synthesis_text": "こくどうぞいのこんびには、れいぞうけーすのひくいおとだけでできているみたいにしずかだった。",
    "start": 2.563,
    "end": 8.282,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v002_ナレーション.wav"
  },
  {
    "id": "ep01_v003",
    "cut": "ep01_004",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "新人夜勤バイトのタクミは、おにぎり棚の前で廃棄時間のシールを見比べていた。",
    "synthesis_text": "しんじんやきんばいとのたくみは、おにぎりだなのまえではいきじかんのしーるをみくらべていた。",
    "start": 9.082,
    "end": 15.092,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v003_ナレーション.wav"
  },
  {
