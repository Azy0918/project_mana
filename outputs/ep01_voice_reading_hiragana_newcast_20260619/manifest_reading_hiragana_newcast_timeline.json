[
  {
    "id": "ep01_v001",
    "cut": "ep01_001",
    "character": "ナレーション",
    "speaker_name": "まい",
    "style_name": "ノーマル",
    "style_id": 1431611904,
    "text": "午前二時三分。",
    "synthesis_text": "ごぜんにじさんぷん。",
    "start": 0.0,
    "end": 1.93,
    "pause_after_ms": 500,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v001_ナレーション.wav"
  },
  {
    "id": "ep01_v002",
    "cut": "ep01_002",
    "character": "ナレーション",
    "speaker_name": "まい",
    "style_name": "ノーマル",
    "style_id": 1431611904,
    "text": "国道沿いのコンビニは、冷蔵ケースの低い音だけでできているみたいに静かだった。",
    "synthesis_text": "こくどうぞいのこんびには、れいぞうけーすのひくいおとだけでできているみたいにしずかだった。",
    "start": 2.43,
    "end": 8.876,
    "pause_after_ms": 800,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v002_ナレーション.wav"
  },
  {
    "id": "ep01_v003",
    "cut": "ep01_004",
    "character": "ナレーション",
    "speaker_name": "まい",
    "style_name": "ノーマル",
    "style_id": 1431611904,
    "text": "新人夜勤バイトのタクミは、おにぎり棚の前で廃棄時間のシールを見比べていた。",
    "synthesis_text": "しんじんやきんばいとのたくみは、おにぎりだなのまえではいきじかんのしーるをみくらべていた。",
    "start": 9.676,
    "end": 16.424,
    "pause_after_ms": 500,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v003_ナレーション.wav"
  },
  {
    "id": "ep01_v004",
    "cut": "ep01_005",
    "character": "タクミ",
    "speaker_name": "にせ",
    "style_name": "ノーマル",
    "style_id": 1937616896,
    "text": "ミナさん。廃棄のおにぎりって、何分前から食べていいんですか。",
    "synthesis_text": "みなさん。はいきのおにぎりって、なんぷんまえからたべていいんですか。",
    "start": 16.924,
    "end": 21.965,
    "pause_after_ms": 300,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v004_タクミ.wav"
  },
  {
    "id": "ep01_v005",
    "cut": "ep01_006",
    "character": "ミナ",
    "speaker_name": "中2",
    "style_name": "ノーマル",
    "style_id": 604166016,
    "text": "食べていいとは言ってない。",
    "synthesis_text": "たべていいとはいってない。",
    "start": 22.265,
    "end": 24.279,
    "pause_after_ms": 350,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v005_ミナ.wav"
  },
  {
    "id": "ep01_v006",
    "cut": "ep01_007",
    "character": "タクミ",
    "speaker_name": "にせ",
    "style_name": "ノーマル",
    "style_id": 1937616896,
    "text": "でも捨てるんですよね。",
    "synthesis_text": "でもすてるんですよね。",
    "start": 24.629,
    "end": 26.675,
    "pause_after_ms": 250,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v006_タクミ.wav"
  },
  {
    "id": "ep01_v007",
    "cut": "ep01_008",
    "character": "ミナ",
    "speaker_name": "中2",
    "style_name": "ノーマル",
    "style_id": 604166016,
    "text": "捨てるものと食べていいものの間には、店長という深い谷がある。",
    "synthesis_text": "すてるものとたべていいもののあいだには、てんちょうというふかいたにがある。",
    "start": 26.925,
    "end": 32.249,
    "pause_after_ms": 300,
    "clip": "outputs/ep01_voice_reading_hiragana_newcast_20260619/clips/ep01_v007_ミナ.wav"
  },
  {
