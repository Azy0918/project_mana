[
  { "id": "ep06_v001", "cut": "ep06_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時九分。", "synthesis_text": "ごぜんにじきゅうふん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v001_ナレーション.wav" },
  { "id": "ep06_v002", "cut": "ep06_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "パン棚の一番奥に、見たことのない袋が並んでいた。", "synthesis_text": "ぱんだなのいちばんおくに、みたことのないふくろがならんでいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v002_ナレーション.wav" },
  { "id": "ep06_v003", "cut": "ep06_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "白い紙袋。印刷はない。赤いスタンプで、なるべく早く食べてください、とだけ押されている。", "synthesis_text": "しろいかみぶくろ。いんさつワない。あかいすたんぷで、なるべくはやくたべてください、とだけおされている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v003_ナレーション.wav" },
  { "id": "ep06_v004", "cut": "ep06_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは袋を持ち上げた。", "synthesis_text": "たくみワ、ふくろをもちあげた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v004_ナレーション.wav" },
  { "id": "ep06_v005", "cut": "ep06_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "エリさん、賞味期限がありません", "synthesis_text": "みなさん、しょうみきげんがありません。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v005_タクミ.wav" },
  { "id": "ep06_v006", "cut": "ep06_vc02", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "昔のパン？", "synthesis_text": "むかしのぱん？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v006_エリ.wav" },
  { "id": "ep06_v007", "cut": "ep06_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "昔のパンでも、今ここにあるのが問題です", "synthesis_text": "むかしのぱんでも、いまここにあるのがもんだいです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v007_タクミ.wav" },
  { "id": "ep06_v008", "cut": "ep06_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "袋の口から、焼きたてに近い匂いがした。しかし紙は古く、手触りは乾いている。", "synthesis_text": "ふくろのくちから、やきたてにちかいにおいがした。しかしかみワふるく、てざわりワかわいている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v008_ナレーション.wav" },
  { "id": "ep06_v009", "cut": "ep06_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v009_ナレーション.wav" },
  { "id": "ep06_v010", "cut": "ep06_vc04", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "賞味期限概念成立前の商品を確認", "synthesis_text": "しょうみきげんがいねんせいりつまえの、しょうひんをかくにん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v010_第十三レジ.wav" },
  { "id": "ep06_v011", "cut": "ep06_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "概念成立前って、パンが哲学みたいになってます", "synthesis_text": "がいねんせいりつまえって、ぱんがてつがくみたいになってます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v011_タクミ.wav" },
  { "id": "ep06_v012", "cut": "ep06_vc05", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "表示：なるべく早く食べてください。保存状態：不明。思い出鮮度：高", "synthesis_text": "ひょうじ、なるべくはやくたべてください。ほぞんじょうたい、ふめい。おもいでせんど、こう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v012_第十三レジ.wav" },
  { "id": "ep06_v013", "cut": "ep06_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "思い出鮮度を商品管理に入れないでください", "synthesis_text": "おもいでせんどを、しょうひんかんりにいれないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v013_タクミ.wav" },
  { "id": "ep06_v014", "cut": "ep06_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はパンを見た。", "synthesis_text": "あせだワ、ぱんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v014_ナレーション.wav" },
  { "id": "ep06_v015", "cut": "ep06_vc06", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "これは過去の商品だが、未来の封印技術が混ざっている。腐敗ではなく、判断基準が古いんだ", "synthesis_text": "これワ、かこのしょうひんだが、みらいのふういんぎじゅつがまざっている。ふはいでワなく、はんだんきじゅんがふるいんだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v015_汗田竜司.wav" },
  { "id": "ep06_v016", "cut": "ep06_vc06", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "食べられるんですか", "synthesis_text": "たべられるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v016_タクミ.wav" },
  { "id": "ep06_v017", "cut": "ep06_vc06", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "安全とは言い切れない", "synthesis_text": "あんぜんとワ、いいきれない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v017_汗田竜司.wav" },
  { "id": "ep06_v018", "cut": "ep06_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは端末を開いた。", "synthesis_text": "みなワ、たんまつをひらいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v018_ナレーション.wav" },
  { "id": "ep06_v019", "cut": "ep06_vc07", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "廃棄？", "synthesis_text": "はいき？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v019_エリ.wav" },
  { "id": "ep06_v020", "cut": "ep06_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "パンの袋が小さく震えた。紙に文字が浮かぶ。", "synthesis_text": "ぱんのふくろがちいさくふるえた。かみにもじがうかぶ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v020_ナレーション.wav" },
  { "id": "ep06_v021", "cut": "ep06_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "まだ、誰かの朝ごはんになれます。", "synthesis_text": "まだ、だれかのあさごはんになれます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v021_ナレーション.wav" },
  { "id": "ep06_v022", "cut": "ep06_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは一歩下がった。", "synthesis_text": "たくみワ、いっぽさがった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v022_ナレーション.wav" },
  { "id": "ep06_v023", "cut": "ep06_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "パンが自己主張した", "synthesis_text": "ぱんがじこしゅちょうした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v023_タクミ.wav" },
  { "id": "ep06_v024", "cut": "ep06_vc09", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "注意。この商品を廃棄すると、過去店舗の善意記録が一件消失します。販売すると、現代の食品表示ルールに抵触します", "synthesis_text": "ちゅうい。このしょうひんをはいきすると、かこてんぽのぜんいきろくがいっけんしょうしつします。はんばいすると、げんだいのしょくひんひょうじるーるにていしょくします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v024_第十三レジ.wav" },
  { "id": "ep06_v025", "cut": "ep06_vc09", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "どっちも困る", "synthesis_text": "どっちもこまる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v025_タクミ.wav" },
  { "id": "ep06_v026", "cut": "ep06_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは少し考えて言った。", "synthesis_text": "みなワ、すこしかんがえていった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v026_ナレーション.wav" },
  { "id": "ep06_v027", "cut": "ep06_vc10", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "試食？", "synthesis_text": "ししょく？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v027_エリ.wav" },
  { "id": "ep06_v028", "cut": "ep06_vc10", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "現代のバイトを実験台にしないでください", "synthesis_text": "げんだいのばいとを、じっけんだいにしないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v028_タクミ.wav" },
  { "id": "ep06_v029", "cut": "ep06_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そこへ唐沢栄治が来店した。コンビニ本部のSV、五十三歳。深夜巡回のついで、という顔をしているが、目は棚割りと廃棄率を見ている。", "synthesis_text": "そこエ、からさわえいじがらいてんした。こんびにほんぶのえすぶい、ごじゅうさんさい。しんやじゅんかいのついで、というかおをしているが、めワ、たなわりとはいきりつをみている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v029_ナレーション.wav" },
  { "id": "ep06_v030", "cut": "ep06_vc11", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "深夜二時台の廃棄登録、少しズレがありますね", "synthesis_text": "しんやにじだいのはいきとうろく、すこしずれがありますね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v030_唐沢栄治.wav" },
  { "id": "ep06_v031", "cut": "ep06_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは小声で言った。", "synthesis_text": "たくみワ、こごえでいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v031_ナレーション.wav" },
  { "id": "ep06_v032", "cut": "ep06_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "未来大戦争より怖い人が来た", "synthesis_text": "みらいだいせんそうより、こわいひとがきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v032_タクミ.wav" },
  { "id": "ep06_v033", "cut": "ep06_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢はパンを見た。", "synthesis_text": "からさわワ、ぱんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v033_ナレーション.wav" },
  { "id": "ep06_v034", "cut": "ep06_vc13", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "賞味期限表示なし。売場には出せません", "synthesis_text": "しょうみきげんひょうじなし。うりばにワ、だせません。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v034_唐沢栄治.wav" },
  { "id": "ep06_v035", "cut": "ep06_vc13", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ですよね", "synthesis_text": "ですよね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v035_タクミ.wav" },
  { "id": "ep06_v036", "cut": "ep06_vc13", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "ただし、廃棄理由が不明な商品は、まず保留です。記録を残してください", "synthesis_text": "ただし、はいきりゆうがふめいなしょうひんワ、まずほりゅうです。きろくをのこしてください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v036_唐沢栄治.wav" },
  { "id": "ep06_v037", "cut": "ep06_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田が目を上げた。", "synthesis_text": "あせだがめをあげた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v037_ナレーション.wav" },
  { "id": "ep06_v038", "cut": "ep06_vc14", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "現実の監査が、未来の処理に勝ったな", "synthesis_text": "げんじつのかんさが、みらいのしょりにかったな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v038_汗田竜司.wav" },
  { "id": "ep06_v039", "cut": "ep06_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は意味がわからない顔で続けた。", "synthesis_text": "からさわワ、いみがわからないかおでつづけた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v039_ナレーション.wav" },
  { "id": "ep06_v040", "cut": "ep06_vc14", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "数字が合わないものを感覚で捨てると、後で困ります", "synthesis_text": "すうじがあわないものを、かんかくですてると、あとでこまります。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v040_唐沢栄治.wav" },
  { "id": "ep06_v041", "cut": "ep06_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリはうなずいた。", "synthesis_text": "みなワ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v041_ナレーション.wav" },
  { "id": "ep06_v042", "cut": "ep06_vc15", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "保留", "synthesis_text": "ほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v042_エリ.wav" },
  { "id": "ep06_v043", "cut": "ep06_vc15", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "処理を確認。販売不可。廃棄不可。現代店舗で保留", "synthesis_text": "しょりをかくにん。はんばいふか。はいきふか。げんだいてんぽでほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v043_第十三レジ.wav" },
  { "id": "ep06_v044", "cut": "ep06_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはパンの袋へ「販売しない・捨てない・触りすぎない」と書いた付箋を貼った。", "synthesis_text": "たくみワ、ぱんのふくろエ、はんばいしない、すてない、さわりすぎない、とかいたふせんをはった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v044_ナレーション.wav" },
  { "id": "ep06_v045", "cut": "ep06_vc16", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "こんな曖昧な表示でいいんですか", "synthesis_text": "こんなあいまいなひょうじでいいんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v045_タクミ.wav" },
  { "id": "ep06_v046", "cut": "ep06_vc16", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "未来の一部が安定しました", "synthesis_text": "みらいのいちぶが、あんていしました。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v046_第十三レジ.wav" },
  { "id": "ep06_v047", "cut": "ep06_vc17", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "付箋で？", "synthesis_text": "ふせんで？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v047_タクミ.wav" },
  { "id": "ep06_v048", "cut": "ep06_vc17", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "現場運用は強い", "synthesis_text": "げんばうんようワ、つよい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v048_エリ.wav" },
  { "id": "ep06_v049", "cut": "ep06_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "レシートが印刷された。", "synthesis_text": "れしーとがいんさつされた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v049_ナレーション.wav" },
  { "id": "ep06_v050", "cut": "ep06_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢はレシートを見た。", "synthesis_text": "からさわワ、れしーとをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v050_ナレーション.wav" },
  { "id": "ep06_v051", "cut": "ep06_vc18", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "店長確認が未了のままなら、バックヤードに明記してください", "synthesis_text": "てんちょうかくにんがみりょうのままなら、ばっくやーどにめいきしてください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v051_唐沢栄治.wav" },
  { "id": "ep06_v052", "cut": "ep06_vc19", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "そこ、普通に指摘するんですね", "synthesis_text": "そこ、ふつうにしてきするんですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v052_タクミ.wav" },
  { "id": "ep06_v053", "cut": "ep06_vc19", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "監査で見ます", "synthesis_text": "かんさでみます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v053_唐沢栄治.wav" },
  { "id": "ep06_v054", "cut": "ep06_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢が帰ると、タクミはマニュアルに書き足した。", "synthesis_text": "からさわがかえると、たくみワ、まにゅあるにかきたした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v054_ナレーション.wav" },
  { "id": "ep06_v055", "cut": "ep06_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "判断できないものは保留。売れないものは売らない。でも、すぐ捨てるとも限らない。", "synthesis_text": "はんだんできないものワ、ほりゅう。うれないものワ、うらない。でも、すぐすてるともかぎらない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v055_ナレーション.wav" },
  { "id": "ep06_v056", "cut": "ep06_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは保留箱を棚に置いた。", "synthesis_text": "みなワ、ほりゅうばこをたなにおいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v056_ナレーション.wav" },
  { "id": "ep06_v057", "cut": "ep06_vc21", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "パン、朝まで置いておく", "synthesis_text": "ぱん、あさまでおいておく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v057_エリ.wav" },
  { "id": "ep06_v058", "cut": "ep06_vc21", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "朝が来たらどうします？", "synthesis_text": "あさがきたらどうします？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v058_タクミ.wav" },
  { "id": "ep06_v059", "cut": "ep06_vc21", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "店長確認", "synthesis_text": "てんちょうかくにん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v059_エリ.wav" },
  { "id": "ep06_v060", "cut": "ep06_vc21", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "永遠に来ない気がする", "synthesis_text": "えいえんにこないきがする。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep06_voice_reading_hiragana\\clips\\ep06_v060_タクミ.wav" }
]
