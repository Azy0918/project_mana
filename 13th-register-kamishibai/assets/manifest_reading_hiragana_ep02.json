    "character": "ナレーション",
    "speaker_name": "澤原 玄二郎",
    "style_name": "ノーマル",
    "style_id": 2029042368,
    "text": "役員の言葉が、まだ耳に残っていた。",
    "synthesis_text": "やくいんのことばが、まだ、みみにのこっていた。",
    "synthesis_source": "reading_hiragana",
    "pause_after_ms": 450,
    "clip": "outputs\\ep02_voice_reading_hiragana\\clips\\ep02_v003_ナレーション.wav"
  },
  {
