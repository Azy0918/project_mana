[
  { "id": "ep10_v001", "cut": "ep10_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時十一分。タクミはバックヤードのファイルを開いていた。", "synthesis_text": "ごぜんにじじゅういっぷん。たくみワ、ばっくやーどのふぁいるをひらいていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v001_ナレーション.wav" },
  { "id": "ep10_v002", "cut": "ep10_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第1話のレシート。時空返品、一件。歴史メモ、一件。完全栄養おにぎり、開発継続。", "synthesis_text": "だいいちわのれしーと。じくうへんぴん、いっけん。れきしめも、いっけん。かんぜんえいようおにぎり、かいはつけいぞく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v002_ナレーション.wav" },
  { "id": "ep10_v003", "cut": "ep10_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ミナさん、これ本当に本人確認に使うんですか", "synthesis_text": "みなさん、これほんとうにほんにんかくにんにつかうんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v003_タクミ.wav" },
  { "id": "ep10_v004", "cut": "ep10_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "レシートあるから", "synthesis_text": "れしーとあるから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v004_ミナ.wav" },
  { "id": "ep10_v005", "cut": "ep10_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "人間に対して使う言葉じゃないです", "synthesis_text": "にんげんにたいしてつかうことばじゃないです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v005_タクミ.wav" },
  { "id": "ep10_v006", "cut": "ep10_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "自動ドアが開いた。入ってきたのは、くたびれたスーツではなく、普通のジャケットを着た青年だった。", "synthesis_text": "じどうどあがひらいた。ハいってきたのワ、くたびれたすーつでワなく、ふつうのじゃけっとをきたせいねんだった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v006_ナレーション.wav" },
  { "id": "ep10_v007", "cut": "ep10_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "だが顔には見覚えがある。第1話の未来の会社員だ。", "synthesis_text": "だがかおにワ、みおぼえがある。だいいちわのみらいのかいしゃいんだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v007_ナレーション.wav" },
  { "id": "ep10_v008", "cut": "ep10_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は店内を見回した。", "synthesis_text": "せいねんワ、てんないをみまわした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v008_ナレーション.wav" },
  { "id": "ep10_v009", "cut": "ep10_vc04", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "あの、ここ……前にも来ました？", "synthesis_text": "あの、ここ……まえにもきました？", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v009_未来の会社員.wav" },
  { "id": "ep10_v010", "cut": "ep10_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは思わず言った。", "synthesis_text": "たくみワ、おもわずいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v010_ナレーション.wav" },
  { "id": "ep10_v011", "cut": "ep10_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "来ました。未来から。おにぎり持って", "synthesis_text": "きました。みらいから。おにぎりもって。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v011_タクミ.wav" },
  { "id": "ep10_v012", "cut": "ep10_vc04", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "おにぎり？", "synthesis_text": "おにぎり？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v012_未来の会社員.wav" },
  { "id": "ep10_v013", "cut": "ep10_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "そこから忘れてる", "synthesis_text": "そこからわすれてる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v013_タクミ.wav" },
  { "id": "ep10_v014", "cut": "ep10_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "首元には、透明なパッチが貼られていた。前よりも端が浮いていて、中の銀色の回路が弱く点滅している。", "synthesis_text": "くびもとにワ、とうめいなぱっちがはられていた。まえよりもはしがういていて、なかのぎんいろのかいろがよわくてんめつしている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v014_ナレーション.wav" },
  { "id": "ep10_v015", "cut": "ep10_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v015_ナレーション.wav" },
  { "id": "ep10_v016", "cut": "ep10_vc06", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "危険知識保持者を確認。記憶返品タグ、劣化。未来大戦争発生率、上昇中", "synthesis_text": "きけんちしきほじしゃをかくにん。きおくへんぴんたぐ、れっか。みらいだいせんそうはっせいりつ、じょうしょうちゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v016_第十三レジ.wav" },
  { "id": "ep10_v017", "cut": "ep10_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は目を丸くした。", "synthesis_text": "せいねんワ、めをまるくした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v017_ナレーション.wav" },
  { "id": "ep10_v018", "cut": "ep10_vc06", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "危険知識保持者って、私ですか", "synthesis_text": "きけんちしきほじしゃって、わたしですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v018_未来の会社員.wav" },
  { "id": "ep10_v019", "cut": "ep10_vc07", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "外見年齢、四十二歳。実年齢、二十七歳", "synthesis_text": "がいけんねんれい、よんじゅうにさい。じつねんれい、にじゅうななさい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v019_第十三レジ.wav" },
  { "id": "ep10_v020", "cut": "ep10_vc07", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "えっ", "synthesis_text": "えっ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v020_未来の会社員.wav" },
  { "id": "ep10_v021", "cut": "ep10_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは第十三レジを叩きそうになった。", "synthesis_text": "たくみワ、だいじゅうさんれじをたたきそうになった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v021_ナレーション.wav" },
  { "id": "ep10_v022", "cut": "ep10_vc07", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "レジが人の老け具合を出すな", "synthesis_text": "れじがひとのふけぐあいをだすな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v022_タクミ.wav" },
  { "id": "ep10_v023", "cut": "ep10_vc08", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "原因、残業", "synthesis_text": "げんいん、ざんぎょう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v023_第十三レジ.wav" },
  { "id": "ep10_v024", "cut": "ep10_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "未来の労働環境を診断するな", "synthesis_text": "みらいのろうどうかんきょうをしんだんするな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v024_タクミ.wav" },
  { "id": "ep10_v025", "cut": "ep10_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田が入ってきた。ナビはすでに赤く点滅している。", "synthesis_text": "あせだがハいってきた。なびワ、すでにあかくてんめつしている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v025_ナレーション.wav" },
  { "id": "ep10_v026", "cut": "ep10_vc09", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "封印タグが剥がれかけている。中の知識が戻り始めれば、物流最適化システムの危険な使い方まで思い出すかもしれない", "synthesis_text": "ふういんたぐがはがれかけている。なかのちしきがもどりはじめれば、ぶつりゅうさいてきかしすてむのきけんなつかいかたまでおもいだすかもしれない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v026_汗田竜司.wav" },
  { "id": "ep10_v027", "cut": "ep10_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は不安そうに首元を押さえた。", "synthesis_text": "せいねんワ、ふあんそうにくびもとをおさえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v027_ナレーション.wav" },
  { "id": "ep10_v028", "cut": "ep10_vc09", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "私は、ただの会社員です", "synthesis_text": "わたしワ、ただのかいしゃいんです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v028_未来の会社員.wav" },
  { "id": "ep10_v029", "cut": "ep10_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはレシートを出した。", "synthesis_text": "みなワ、れしーとをだした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v029_ナレーション.wav" },
  { "id": "ep10_v030", "cut": "ep10_vc10", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "確認します", "synthesis_text": "かくにんします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v030_ミナ.wav" },
  { "id": "ep10_v031", "cut": "ep10_vc10", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "何をですか", "synthesis_text": "なにをですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v031_未来の会社員.wav" },
  { "id": "ep10_v032", "cut": "ep10_vc10", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "お客様", "synthesis_text": "おきゃくさま。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v032_ミナ.wav" },
  { "id": "ep10_v033", "cut": "ep10_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミが小声で言った。", "synthesis_text": "たくみが、こごえでいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v033_ナレーション.wav" },
  { "id": "ep10_v034", "cut": "ep10_vc11", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "人間確認にレシート使うんですか", "synthesis_text": "にんげんかくにんに、れしーとつかうんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v034_タクミ.wav" },
  { "id": "ep10_v035", "cut": "ep10_vc11", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "時空返品レシートを照合してください", "synthesis_text": "じくうへんぴんれしーとを、しょうごうしてください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v035_第十三レジ.wav" },
  { "id": "ep10_v036", "cut": "ep10_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはバーコードを読み取った。", "synthesis_text": "たくみワ、ばーこーどをよみとった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 200, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v036_ナレーション.wav" },
  { "id": "ep10_v037", "cut": "ep10_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ピッ。", "synthesis_text": "ぴっ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v037_ナレーション.wav" },
  { "id": "ep10_v038", "cut": "ep10_vc12", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "本人確認、一部完了。返品済み青年。記憶封印中。開封厳禁", "synthesis_text": "ほんにんかくにん、いちぶかんりょう。へんぴんずみせいねん。きおくふういんちゅう。かいふうげんきん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v038_第十三レジ.wav" },
  { "id": "ep10_v039", "cut": "ep10_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年はレシートを見た。", "synthesis_text": "せいねんワ、れしーとをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v039_ナレーション.wav" },
  { "id": "ep10_v040", "cut": "ep10_vc12", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "私、返品済みなんですか", "synthesis_text": "わたし、へんぴんずみなんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v040_未来の会社員.wav" },
  { "id": "ep10_v041", "cut": "ep10_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "言い方がひどいだけで、たぶん助かった方です", "synthesis_text": "いいかたがひどいだけで、たぶんたすかったほうです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v041_タクミ.wav" },
  { "id": "ep10_v042", "cut": "ep10_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはパッチを見た。", "synthesis_text": "みなワ、ぱっちをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v042_ナレーション.wav" },
  { "id": "ep10_v043", "cut": "ep10_vc13", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "剥がさない方がいい", "synthesis_text": "はがさないほうがいい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v043_ミナ.wav" },
  { "id": "ep10_v044", "cut": "ep10_vc13", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "はい", "synthesis_text": "はい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v044_未来の会社員.wav" },
  { "id": "ep10_v045", "cut": "ep10_vc14", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "処理候補。未来へ返品。記憶開封。宇宙監査局へ返送。現代店舗で一時保留", "synthesis_text": "しょりこうほ。みらいエへんぴん。きおくかいふう。うちゅうかんさきょくエへんそう。げんだいてんぽでいちじほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v045_第十三レジ.wav" },
  { "id": "ep10_v046", "cut": "ep10_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はすぐに言った。", "synthesis_text": "あせだワ、すぐにいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v046_ナレーション.wav" },
  { "id": "ep10_v047", "cut": "ep10_vc14", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "まだ決めるな。本人の記憶も、知識の価値も、危険性も、整理できていない", "synthesis_text": "まだきめるな。ほんにんのきおくも、ちしきのかちも、きけんせいも、せいりできていない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v047_汗田竜司.wav" },
  { "id": "ep10_v048", "cut": "ep10_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはうなずいた。", "synthesis_text": "みなワ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v048_ナレーション.wav" },
  { "id": "ep10_v049", "cut": "ep10_vc15", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "保留", "synthesis_text": "ほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v049_ミナ.wav" },
  { "id": "ep10_v050", "cut": "ep10_vc15", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "一時保留を受理。ただし、劣化進行中。次回棚卸し時に再確認が必要です", "synthesis_text": "いちじほりゅうをじゅり。ただし、れっかしんこうちゅう。じかいたなおろしじに、さいかくにんがひつようです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v050_第十三レジ.wav" },
  { "id": "ep10_v051", "cut": "ep10_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は小さく息を吐いた。", "synthesis_text": "せいねんワ、ちいさくいきをはいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v051_ナレーション.wav" },
  { "id": "ep10_v052", "cut": "ep10_vc16", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "私は、どうすれば", "synthesis_text": "わたしワ、どうすれば。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v052_未来の会社員.wav" },
  { "id": "ep10_v053", "cut": "ep10_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは迷ったが、いつもの接客の声で言った。", "synthesis_text": "たくみワ、まよったが、いつものせっきゃくのこえでいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v053_ナレーション.wav" },
  { "id": "ep10_v054", "cut": "ep10_vc16", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "とりあえず、コーヒー飲みます？", "synthesis_text": "とりあえず、こーひーのみます？", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v054_タクミ.wav" },
  { "id": "ep10_v055", "cut": "ep10_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は少し笑った。", "synthesis_text": "せいねんワ、すこしわらった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v055_ナレーション.wav" },
  { "id": "ep10_v056", "cut": "ep10_vc17", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "レギュラーで。安いので", "synthesis_text": "れぎゅらーで。やすいので。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v056_未来の会社員.wav" },
  { "id": "ep10_v057", "cut": "ep10_vc17", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "そこは覚えてるんだ", "synthesis_text": "そこワ、おぼえてるんだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v057_タクミ.wav" },
  { "id": "ep10_v058", "cut": "ep10_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "レシートが出た。", "synthesis_text": "れしーとがでた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v058_ナレーション.wav" },
  { "id": "ep10_v059", "cut": "ep10_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはマニュアルに書いた。", "synthesis_text": "たくみワ、まにゅあるにかいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v059_ナレーション.wav" },
  { "id": "ep10_v060", "cut": "ep10_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "危険知識は剥がさない。人間確認にもレシートを使う場合がある。ただし、言い方には気をつける。", "synthesis_text": "きけんちしきワ、はがさない。にんげんかくにんにも、れしーとをつかうばあいがある。ただし、いいかたにワ、きをつける。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v060_ナレーション.wav" },
  { "id": "ep10_v061", "cut": "ep10_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年はコーヒーを持って、店内の端に座った。", "synthesis_text": "せいねんワ、こーひーをもって、てんないのはしにすわった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v061_ナレーション.wav" },
  { "id": "ep10_v062", "cut": "ep10_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "普通の客のようで、普通ではない。", "synthesis_text": "ふつうのきゃくのようで、ふつうでワない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v062_ナレーション.wav" },
  { "id": "ep10_v063", "cut": "ep10_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そしてコピー機が、静かに紙を出した。", "synthesis_text": "そして、こぴーきが、しずかにかみをだした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v063_ナレーション.wav" },
  { "id": "ep10_v064", "cut": "ep10_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "明日、第十二レジと第十四レジの記録が混ざります。", "synthesis_text": "あした、だいじゅうにれじと、だいじゅうよんれじのきろくがまざります。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v064_ナレーション.wav" },
  { "id": "ep10_v065", "cut": "ep10_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは天井を見た。", "synthesis_text": "たくみワ、てんじょうをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v065_ナレーション.wav" },
  { "id": "ep10_v066", "cut": "ep10_vc21", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "レジって、増殖するものなんですか", "synthesis_text": "れじって、ぞうしょくするものなんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v066_タクミ.wav" },
  { "id": "ep10_v067", "cut": "ep10_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは涼しい顔で答えた。", "synthesis_text": "みなワ、すずしいかおでこたえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v067_ナレーション.wav" },
  { "id": "ep10_v068", "cut": "ep10_vc21", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "棚卸しで数えよう", "synthesis_text": "たなおろしでかぞえよう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep10_voice_reading_hiragana\\clips\\ep10_v068_ミナ.wav" }
]
