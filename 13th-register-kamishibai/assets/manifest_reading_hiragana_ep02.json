    "character": "ナビ",
    "speaker_name": "コハク",
    "style_name": "ノーマル",
    "style_id": 1878365376,
    "text": "助けてください。第十三レジを探しています",
    "synthesis_text": "たすけてください。だいじゅうさんれじをさがしています。",
