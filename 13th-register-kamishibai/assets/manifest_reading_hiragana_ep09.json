[
  { "id": "ep09_v001", "cut": "ep09_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時六分。タクミはレジ横のポイントカード読取機を見ていた。", "synthesis_text": "ごぜんにじろっぷん。たくみワ、れじよこのぽいんとかーどよみとりきをみていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v001_ナレーション.wav" },
  { "id": "ep09_v002", "cut": "ep09_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ランプが青ではなく、星空みたいに光っている。", "synthesis_text": "らんぷがあおでワなく、ほしぞらみたいにひかっている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v002_ナレーション.wav" },
  { "id": "ep09_v003", "cut": "ep09_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "エリさん、ポイント端末が宇宙っぽいです", "synthesis_text": "みなさん、ぽいんとたんまつがうちゅうっぽいです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v003_タクミ.wav" },
  { "id": "ep09_v004", "cut": "ep09_vc02", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "キャンペーン？", "synthesis_text": "きゃんぺーん？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v004_エリ.wav" },
  { "id": "ep09_v005", "cut": "ep09_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "本部、ここまで攻めます？", "synthesis_text": "ほんぶ、ここまでせめます？", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v005_タクミ.wav" },
  { "id": "ep09_v006", "cut": "ep09_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "自動ドアが開いた。座木山が入ってきて、コピー機に向かう途中で古いカードを落とした。", "synthesis_text": "じどうどあがひらいた。ざきやまがハいってきて、こぴーきにむかうとちゅうで、ふるいかーどをおとした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v006_ナレーション.wav" },
  { "id": "ep09_v007", "cut": "ep09_vc03", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "座木山さん、カード落ちましたよ", "synthesis_text": "ざきやまさん、かーどおちましたよ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v007_タクミ.wav" },
  { "id": "ep09_v008", "cut": "ep09_vc03", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "ああ、昔のポイントカードかな", "synthesis_text": "ああ、むかしのぽいんとかーどかな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v008_座木山辰哉.wav" },
  { "id": "ep09_v009", "cut": "ep09_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "カードには、銀河共通ポイント、と書かれていた。", "synthesis_text": "かーどにワ、ぎんがきょうつうぽいんと、とかかれていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v009_ナレーション.wav" },
  { "id": "ep09_v010", "cut": "ep09_vc03", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "昔の範囲が広すぎる", "synthesis_text": "むかしのはんいがひろすぎる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v010_タクミ.wav" },
  { "id": "ep09_v011", "cut": "ep09_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v011_ナレーション.wav" },
  { "id": "ep09_v012", "cut": "ep09_vc04", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "銀河共通ポイントカードを確認。残高、八兆ポイント", "synthesis_text": "ぎんがきょうつうぽいんとかーどをかくにん。ざんだか、はっちょうぽいんと。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v012_第十三レジ.wav" },
  { "id": "ep09_v013", "cut": "ep09_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはカードを持つ手を震わせた。", "synthesis_text": "たくみワ、かーどをもつてをふるわせた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v013_ナレーション.wav" },
  { "id": "ep09_v014", "cut": "ep09_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "八兆？", "synthesis_text": "はっちょう？", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v014_タクミ.wav" },
  { "id": "ep09_v015", "cut": "ep09_vc05", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "地球円へ変換しますか", "synthesis_text": "ちきゅうえんエ、へんかんしますか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v015_第十三レジ.wav" },
  { "id": "ep09_v016", "cut": "ep09_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "しないでください！", "synthesis_text": "しないでください！", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v016_タクミ.wav" },
  { "id": "ep09_v017", "cut": "ep09_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは少しだけ首を傾けた。", "synthesis_text": "みなワ、すこしだけくびをかしげた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v017_ナレーション.wav" },
  { "id": "ep09_v018", "cut": "ep09_vc05", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "使えるなら使う？", "synthesis_text": "つかえるならつかう？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v018_エリ.wav" },
  { "id": "ep09_v019", "cut": "ep09_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "店が国になる", "synthesis_text": "みせがくにになる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v019_タクミ.wav" },
  { "id": "ep09_v020", "cut": "ep09_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田がナビを確認した。", "synthesis_text": "あせだがなびをかくにんした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v020_ナレーション.wav" },
  { "id": "ep09_v021", "cut": "ep09_vc06", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "このポイントは単なる購買履歴ではない。宇宙物流の信用残高だ。変換すると、この店の売上が異常値になり、未来側の補給権限がここへ集まる", "synthesis_text": "このぽいんとワ、たんなるこうばいりれきでワない。うちゅうぶつりゅうのしんようざんだかだ。へんかんすると、このみせのうりあげがいじょうちになり、みらいがわのほきゅうけんげんがここエあつまる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v021_汗田竜司.wav" },
  { "id": "ep09_v022", "cut": "ep09_vc06", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ポイントカードで戦争が近づくの、嫌すぎる", "synthesis_text": "ぽいんとかーどでせんそうがちかづくの、いやすぎる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v022_タクミ.wav" },
  { "id": "ep09_v023", "cut": "ep09_vc07", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "危険知識保持者の再来店予定通知あり。ポイント履歴に同一署名を確認", "synthesis_text": "きけんちしきほじしゃの、さいらいてんよていつうちあり。ぽいんとりれきに、どういつしょめいをかくにん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v023_第十三レジ.wav" },
  { "id": "ep09_v024", "cut": "ep09_vc07", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "次の話の空気が重い", "synthesis_text": "つぎのはなしのくうきがおもい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v024_タクミ.wav" },
  { "id": "ep09_v025", "cut": "ep09_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そこへ唐沢が来た。", "synthesis_text": "そこエ、からさわがきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v025_ナレーション.wav" },
  { "id": "ep09_v026", "cut": "ep09_vc08", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "深夜二時台の客単価が高いですね", "synthesis_text": "しんやにじだいのきゃくたんかが、たかいですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v026_唐沢栄治.wav" },
  { "id": "ep09_v027", "cut": "ep09_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは青ざめた。", "synthesis_text": "たくみワ、あおざめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v027_ナレーション.wav" },
  { "id": "ep09_v028", "cut": "ep09_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "まだ上がってないです。上がる寸前です", "synthesis_text": "まだあがってないです。あがるすんぜんです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v028_タクミ.wav" },
  { "id": "ep09_v029", "cut": "ep09_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は端末を見た。", "synthesis_text": "からさわワ、たんまつをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v029_ナレーション.wav" },
  { "id": "ep09_v030", "cut": "ep09_vc09", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "八兆ポイント。これは会計に乗せないでください。異常値は集計前に保留です", "synthesis_text": "はっちょうぽいんと。これワ、かいけいにのせないでください。いじょうちワ、しゅうけいまえにほりゅうです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v030_唐沢栄治.wav" },
  { "id": "ep09_v031", "cut": "ep09_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田が低く笑った。", "synthesis_text": "あせだが、ひくくわらった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v031_ナレーション.wav" },
  { "id": "ep09_v032", "cut": "ep09_vc09", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "また現実の監査が強い", "synthesis_text": "また、げんじつのかんさがつよい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v032_汗田竜司.wav" },
  { "id": "ep09_v033", "cut": "ep09_vc10", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "処理候補。地球円変換。銀河残高維持。期限切れ処理。保留", "synthesis_text": "しょりこうほ。ちきゅうえんへんかん。ぎんがざんだかいじ。きげんぎれしょり。ほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v033_第十三レジ.wav" },
  { "id": "ep09_v034", "cut": "ep09_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは座木山に聞いた。", "synthesis_text": "みなワ、ざきやまにきいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v034_ナレーション.wav" },
  { "id": "ep09_v035", "cut": "ep09_vc11", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "使います？", "synthesis_text": "つかいます？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v035_エリ.wav" },
  { "id": "ep09_v036", "cut": "ep09_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "座木山は首を振った。", "synthesis_text": "ざきやまワ、くびをふった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v036_ナレーション.wav" },
  { "id": "ep09_v037", "cut": "ep09_vc11", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "貯めた覚えがないものは、使うとあとが怖いからね", "synthesis_text": "ためたおぼえがないものワ、つかうとあとがこわいからね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v037_座木山辰哉.wav" },
  { "id": "ep09_v038", "cut": "ep09_vc11", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "急に核心", "synthesis_text": "きゅうにかくしん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v038_タクミ.wav" },
  { "id": "ep09_v039", "cut": "ep09_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリは端末を操作した。", "synthesis_text": "みなワ、たんまつをそうさした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v039_ナレーション.wav" },
  { "id": "ep09_v040", "cut": "ep09_vc12", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "期限確認", "synthesis_text": "きげんかくにん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v040_エリ.wav" },
  { "id": "ep09_v041", "cut": "ep09_vc12", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "最終利用日、二億年前", "synthesis_text": "さいしゅうりようび、におくねんまえ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v041_第十三レジ.wav" },
  { "id": "ep09_v042", "cut": "ep09_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "長期未利用にもほどがある", "synthesis_text": "ちょうきみりようにも、ほどがある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v042_タクミ.wav" },
  { "id": "ep09_v043", "cut": "ep09_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は即答した。", "synthesis_text": "からさわワ、そくとうした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v043_ナレーション.wav" },
  { "id": "ep09_v044", "cut": "ep09_vc13", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "失効処理ですね", "synthesis_text": "しっこうしょりですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v044_唐沢栄治.wav" },
  { "id": "ep09_v045", "cut": "ep09_vc13", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "二億年前のポイントを失効で片づける本部の人", "synthesis_text": "におくねんまえのぽいんとを、しっこうでかたづけるほんぶのひと。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v045_タクミ.wav" },
  { "id": "ep09_v046", "cut": "ep09_vc13", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "銀河ポイント失効処理を開始します", "synthesis_text": "ぎんがぽいんとしっこうしょりをかいしします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v046_第十三レジ.wav" },
  { "id": "ep09_v047", "cut": "ep09_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "店内の蛍光灯が星空みたいに瞬いた。", "synthesis_text": "てんないのけいこうとうが、ほしぞらみたいにまたたいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v047_ナレーション.wav" },
  { "id": "ep09_v048", "cut": "ep09_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ポイント残高が八兆、七兆、三兆、一億、十、ゼロ、と減っていく。", "synthesis_text": "ぽいんとざんだかが、はっちょう、ななちょう、さんちょう、いちおく、じゅう、ぜろ、とへっていく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v048_ナレーション.wav" },
  { "id": "ep09_v049", "cut": "ep09_vc14", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "失効完了。店の売上、正常範囲", "synthesis_text": "しっこうかんりょう。みせのうりあげ、せいじょうはんい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v049_第十三レジ.wav" },
  { "id": "ep09_v050", "cut": "ep09_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは胸をなで下ろした。", "synthesis_text": "たくみワ、むねをなでおろした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v050_ナレーション.wav" },
  { "id": "ep09_v051", "cut": "ep09_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "レシートが出た。", "synthesis_text": "れしーとがでた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v051_ナレーション.wav" },
  { "id": "ep09_v052", "cut": "ep09_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは最後の方を見て黙った。", "synthesis_text": "たくみワ、さいごのほうをみてだまった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v052_ナレーション.wav" },
  { "id": "ep09_v053", "cut": "ep09_vc15", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "来るんですね。あの未来の会社員", "synthesis_text": "くるんですね。あのみらいのかいしゃいん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v053_タクミ.wav" },
  { "id": "ep09_v054", "cut": "ep09_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はうなずいた。", "synthesis_text": "あせだワ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v054_ナレーション.wav" },
  { "id": "ep09_v055", "cut": "ep09_vc16", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "おそらく、封印が劣化している", "synthesis_text": "おそらく、ふういんがれっかしている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v055_汗田竜司.wav" },
  { "id": "ep09_v056", "cut": "ep09_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "エリはいつも通り言った。", "synthesis_text": "みなワ、いつもどおりいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v056_ナレーション.wav" },
  { "id": "ep09_v057", "cut": "ep09_vc17", "character": "エリ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "レシート探しておこう", "synthesis_text": "れしーとさがしておこう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v057_エリ.wav" },
  { "id": "ep09_v058", "cut": "ep09_vc17", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "人間確認をレシートでやる準備、始めないでください", "synthesis_text": "にんげんかくにんをれしーとでやるじゅんび、はじめないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v058_タクミ.wav" },
  { "id": "ep09_v059", "cut": "ep09_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはマニュアルに書き足した。", "synthesis_text": "たくみワ、まにゅあるにかきたした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v059_ナレーション.wav" },
  { "id": "ep09_v060", "cut": "ep09_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "未来大戦争でも現金過不足は出さない。ポイントは、覚えがなければ使わない。", "synthesis_text": "みらいだいせんそうでも、げんきんかふそくワださない。ぽいんとワ、おぼえがなければつかわない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v060_ナレーション.wav" },
  { "id": "ep09_v061", "cut": "ep09_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "コピー機が一枚、勝手に印刷した。", "synthesis_text": "こぴーきがいちまい、かってにいんさつした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v061_ナレーション.wav" },
  { "id": "ep09_v062", "cut": "ep09_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "明日、返品済みの人が来ます。", "synthesis_text": "あした、へんぴんずみのひとがきます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v062_ナレーション.wav" },
  { "id": "ep09_v063", "cut": "ep09_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは紙を見て、深くため息をついた。", "synthesis_text": "たくみワ、かみをみて、ふかくためいきをついた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v063_ナレーション.wav" },
  { "id": "ep09_v064", "cut": "ep09_vc19", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "コピー機の予告、半分だけ信じたいのに、だいたい当たる", "synthesis_text": "こぴーきのよこく、はんぶんだけしんじたいのに、だいたいあたる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep09_voice_reading_hiragana\\clips\\ep09_v064_タクミ.wav" }
]
