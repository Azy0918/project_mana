    "cut": "ep02_vc01",
    "character": "ナレーション",
    "speaker_name": "澤原 玄二郎",
    "style_name": "ノーマル",
    "style_id": 2029042368,
    "text": "三十年以上積み上げたAI運行支援システムの提案は、また棚上げだった。",
    "synthesis_text": "さんじゅうねんいじょうつみあげた、えいあいうんこうしえんしすてむのていあんワ、また、たなあげだった。",
    "synthesis_source": "reading_hiragana",
    "pause_after_ms": 500,
    "clip": "outputs\\ep02_voice_reading_hiragana\\clips\\ep02_v005_ナレーション.wav"
  },
  {
