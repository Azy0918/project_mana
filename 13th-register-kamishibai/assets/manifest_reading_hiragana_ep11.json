[
  { "id": "ep11_v001", "cut": "ep11_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時二分。タクミはバックヤードで棚卸し表を見ていた。", "synthesis_text": "ごぜんにじにふん。たくみワ、ばっくやーどでたなおろしひょうをみていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v001_ナレーション.wav" },
  { "id": "ep11_v002", "cut": "ep11_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "おにぎり、二十四個。パン、三十一個。明日ミルク、一個。現代店舗保留のパン、一個。危険知識保持者、一名。", "synthesis_text": "おにぎり、にじゅうよんこ。ぱん、さんじゅういっこ。あしたみるく、いっこ。げんだいてんぽほりゅうのぱん、いっこ。きけんちしきほじしゃ、いちめい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v002_ナレーション.wav" },
  { "id": "ep11_v003", "cut": "ep11_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ミナさん、棚卸し表に人間が入ってます", "synthesis_text": "みなさん、たなおろしひょうに、にんげんがハいってます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v003_タクミ.wav" },
  { "id": "ep11_v004", "cut": "ep11_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "保留中だから", "synthesis_text": "ほりゅうちゅうだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v004_ミナ.wav" },
  { "id": "ep11_v005", "cut": "ep11_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "在庫扱いしないでください", "synthesis_text": "ざいこあつかいしないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v005_タクミ.wav" },
  { "id": "ep11_v006", "cut": "ep11_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "未来青年は店内のイートイン端で、コーヒーを持って困った顔をしていた。", "synthesis_text": "みらいせいねんワ、てんないのいーといんはしで、こーひーをもってこまったかおをしていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v006_ナレーション.wav" },
  { "id": "ep11_v007", "cut": "ep11_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。いつもの場所に第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。いつものばしょに、だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v007_ナレーション.wav" },
  { "id": "ep11_v008", "cut": "ep11_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "その左右に、さらに二台の影が揺れた。", "synthesis_text": "そのさゆうに、さらに、にだいのかげがゆれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v008_ナレーション.wav" },
  { "id": "ep11_v009", "cut": "ep11_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "左には古い木目調のレジ。右には透明な未来型のレジ。", "synthesis_text": "ひだりにワ、ふるいもくめちょうのれじ。みぎにワ、とうめいなみらいがたのれじ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v009_ナレーション.wav" },
  { "id": "ep11_v010", "cut": "ep11_vc05", "character": "第十二レジ", "speaker_name": "Lux", "style_name": "ノーマル", "style_id": 2031733024, "text": "過去処理を優先します", "synthesis_text": "かこしょりをゆうせんします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v010_第十二レジ.wav" },
  { "id": "ep11_v011", "cut": "ep11_vc05", "character": "第十四レジ", "speaker_name": "花音", "style_name": "ノーマル", "style_id": 1325133120, "text": "未来処理を優先します", "synthesis_text": "みらいしょりをゆうせんします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v011_第十四レジ.wav" },
  { "id": "ep11_v012", "cut": "ep11_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは両手で頭を抱えた。", "synthesis_text": "たくみワ、りょうてであたまをかかえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v012_ナレーション.wav" },
  { "id": "ep11_v013", "cut": "ep11_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "増え方が本格的になってきた", "synthesis_text": "ふえかたが、ほんかくてきになってきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v013_タクミ.wav" },
  { "id": "ep11_v014", "cut": "ep11_vc06", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "記録混線を確認。第十二レジは過去の未処理を回収します。第十四レジは未来の確定処理を要求します", "synthesis_text": "きろくこんせんをかくにん。だいじゅうにれじワ、かこのみしょりをかいしゅうします。だいじゅうよんれじワ、みらいのかくていしょりをようきゅうします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v014_第十三レジ.wav" },
  { "id": "ep11_v015", "cut": "ep11_vc07", "character": "第十二レジ", "speaker_name": "Lux", "style_name": "ノーマル", "style_id": 2031733024, "text": "未来青年を過去へ返品してください", "synthesis_text": "みらいせいねんを、かこエへんぴんしてください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v015_第十二レジ.wav" },
  { "id": "ep11_v016", "cut": "ep11_vc07", "character": "第十四レジ", "speaker_name": "花音", "style_name": "ノーマル", "style_id": 1325133120, "text": "未来青年を未来へ返送してください", "synthesis_text": "みらいせいねんを、みらいエへんそうしてください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v016_第十四レジ.wav" },
  { "id": "ep11_v017", "cut": "ep11_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年は青ざめた。", "synthesis_text": "せいねんワ、あおざめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v017_ナレーション.wav" },
  { "id": "ep11_v018", "cut": "ep11_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田がナビを置いた。", "synthesis_text": "あせだが、なびをおいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v018_ナレーション.wav" },
  { "id": "ep11_v019", "cut": "ep11_vc08", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "どちらも一理ある。過去は原因を戻したい。未来は結果を確定したい。だが、今ここにいる人間を無視している", "synthesis_text": "どちらもいちりある。かこワ、げんいんをもどしたい。みらいワ、けっかをかくていしたい。だが、いまここにいるにんげんをむしている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v019_汗田竜司.wav" },
  { "id": "ep11_v020", "cut": "ep11_vc09", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "第十三レジは、今の業務を処理します", "synthesis_text": "だいじゅうさんれじワ、いまのぎょうむをしょりします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v020_第十三レジ.wav" },
  { "id": "ep11_v021", "cut": "ep11_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは棚卸し表を持った。", "synthesis_text": "みなワ、たなおろしひょうをもった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v021_ナレーション.wav" },
  { "id": "ep11_v022", "cut": "ep11_vc10", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "数えよう", "synthesis_text": "かぞえよう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v022_ミナ.wav" },
  { "id": "ep11_v023", "cut": "ep11_vc10", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "この状況で棚卸し？", "synthesis_text": "このじょうきょうで、たなおろし？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v023_タクミ.wav" },
  { "id": "ep11_v024", "cut": "ep11_vc10", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "今あるものを数える", "synthesis_text": "いまあるものをかぞえる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v024_ミナ.wav" },
  { "id": "ep11_v025", "cut": "ep11_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十二レジが過去の商品を次々に表示する。", "synthesis_text": "だいじゅうにれじが、かこのしょうひんをつぎつぎにひょうじする。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v025_ナレーション.wav" },
  { "id": "ep11_v026", "cut": "ep11_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "昭和伝票、なるべく早く食べてくださいパン、昨日バニラ。", "synthesis_text": "しょうわでんぴょう、なるべくはやくたべてくださいぱん、きのうばにら。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v026_ナレーション.wav" },
  { "id": "ep11_v027", "cut": "ep11_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十四レジは未来の商品を表示する。", "synthesis_text": "だいじゅうよんれじワ、みらいのしょうひんをひょうじする。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v027_ナレーション.wav" },
  { "id": "ep11_v028", "cut": "ep11_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "酸素グミ、銀河ポイント、物流大戦争発生確率。", "synthesis_text": "さんそぐみ、ぎんがぽいんと、ぶつりゅうだいせんそうはっせいかくりつ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v028_ナレーション.wav" },
  { "id": "ep11_v029", "cut": "ep11_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは棚卸し表へ書き込む。", "synthesis_text": "たくみワ、たなおろしひょうエかきこむ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v029_ナレーション.wav" },
  { "id": "ep11_v030", "cut": "ep11_vc13", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "世界線の差異が多すぎます！", "synthesis_text": "せかいせんのさいが、おおすぎます！", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v030_タクミ.wav" },
  { "id": "ep11_v031", "cut": "ep11_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは言った。", "synthesis_text": "みなワ、いった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v031_ナレーション.wav" },
  { "id": "ep11_v032", "cut": "ep11_vc14", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "現物だけ", "synthesis_text": "げんぶつだけ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v032_ミナ.wav" },
  { "id": "ep11_v033", "cut": "ep11_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田もうなずいた。", "synthesis_text": "あせだも、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v033_ナレーション.wav" },
  { "id": "ep11_v034", "cut": "ep11_vc14", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "現物確認は、理論より強い", "synthesis_text": "げんぶつかくにんワ、りろんよりつよい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v034_汗田竜司.wav" },
  { "id": "ep11_v035", "cut": "ep11_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは店内を走った。実際にあるものだけを数える。", "synthesis_text": "たくみワ、てんないをはしった。じっさいにあるものだけをかぞえる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v035_ナレーション.wav" },
  { "id": "ep11_v036", "cut": "ep11_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "保留箱に入ったパン。袋に入った明日ミルク。レシートファイル。青年本人。", "synthesis_text": "ほりゅうばこにハいったぱん。ふくろにハいったあしたみるく。れしーとふぁいる。せいねんほんにん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v036_ナレーション.wav" },
  { "id": "ep11_v037", "cut": "ep11_vc16", "character": "第十二レジ", "speaker_name": "Lux", "style_name": "ノーマル", "style_id": 2031733024, "text": "過去記録と不一致", "synthesis_text": "かこきろくと、ふいっち。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v037_第十二レジ.wav" },
  { "id": "ep11_v038", "cut": "ep11_vc16", "character": "第十四レジ", "speaker_name": "花音", "style_name": "ノーマル", "style_id": 1325133120, "text": "未来予測と不一致", "synthesis_text": "みらいよそくと、ふいっち。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v038_第十四レジ.wav" },
  { "id": "ep11_v039", "cut": "ep11_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは棚卸し表にハンコを押した。", "synthesis_text": "みなワ、たなおろしひょうにはんこをおした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v039_ナレーション.wav" },
  { "id": "ep11_v040", "cut": "ep11_vc17", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "今の店では、これだけ", "synthesis_text": "いまのみせでワ、これだけ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v040_ミナ.wav" },
  { "id": "ep11_v041", "cut": "ep11_vc17", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "現代店舗棚卸しを受理。第十二レジ、第十四レジの記録を保留へ移行します", "synthesis_text": "げんだいてんぽたなおろしをじゅり。だいじゅうにれじ、だいじゅうよんれじのきろくを、ほりゅうエいこうします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v041_第十三レジ.wav" },
  { "id": "ep11_v042", "cut": "ep11_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "左右のレジが薄くなった。", "synthesis_text": "さゆうのれじが、うすくなった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v042_ナレーション.wav" },
  { "id": "ep11_v043", "cut": "ep11_vc18", "character": "第十二レジ", "speaker_name": "Lux", "style_name": "ノーマル", "style_id": 2031733024, "text": "過去は未処理です", "synthesis_text": "かこワ、みしょりです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v043_第十二レジ.wav" },
  { "id": "ep11_v044", "cut": "ep11_vc18", "character": "第十四レジ", "speaker_name": "花音", "style_name": "ノーマル", "style_id": 1325133120, "text": "未来は未確定です", "synthesis_text": "みらいワ、みかくていです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v044_第十四レジ.wav" },
  { "id": "ep11_v045", "cut": "ep11_vc18", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "今、処理中です", "synthesis_text": "いま、しょりちゅうです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v045_第十三レジ.wav" },
  { "id": "ep11_v046", "cut": "ep11_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはその言葉に少しだけ息を止めた。", "synthesis_text": "たくみワ、そのことばに、すこしだけいきをとめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v046_ナレーション.wav" },
  { "id": "ep11_v047", "cut": "ep11_vc19", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "第十三レジって、そういう意味だったんですね", "synthesis_text": "だいじゅうさんれじって、そういういみだったんですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v047_タクミ.wav" },
  { "id": "ep11_v048", "cut": "ep11_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは淡々と言った。", "synthesis_text": "みなワ、たんたんといった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v048_ナレーション.wav" },
  { "id": "ep11_v049", "cut": "ep11_vc20", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "夜勤だから", "synthesis_text": "やきんだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v049_ミナ.wav" },
  { "id": "ep11_v050", "cut": "ep11_vc20", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "雑に戻した", "synthesis_text": "ざつにもどした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v050_タクミ.wav" },
  { "id": "ep11_v051", "cut": "ep11_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢が巡回に来た。", "synthesis_text": "からさわが、じゅんかいにきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v051_ナレーション.wav" },
  { "id": "ep11_v052", "cut": "ep11_vc21", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "棚卸し差異、出ていますか", "synthesis_text": "たなおろしさい、でていますか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v052_唐沢栄治.wav" },
  { "id": "ep11_v053", "cut": "ep11_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは棚卸し表を隠しかけた。", "synthesis_text": "たくみワ、たなおろしひょうをかくしかけた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v053_ナレーション.wav" },
  { "id": "ep11_v054", "cut": "ep11_vc21", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "人間一名が差異かもしれません", "synthesis_text": "にんげんいちめいが、さいかもしれません。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v054_タクミ.wav" },
  { "id": "ep11_v055", "cut": "ep11_vc22", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は表を見て、冷静に言った。", "synthesis_text": "からさわワ、ひょうをみて、れいせいにいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v055_ナレーション.wav" },
  { "id": "ep11_v056", "cut": "ep11_vc22", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "数字が合わないものは、まず保留です。現金過不足は出さないでください", "synthesis_text": "すうじがあわないものワ、まずほりゅうです。げんきんかふそくワ、ださないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v056_唐沢栄治.wav" },
  { "id": "ep11_v057", "cut": "ep11_vc22", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は静かに言った。", "synthesis_text": "あせだワ、しずかにいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v057_ナレーション.wav" },
  { "id": "ep11_v058", "cut": "ep11_vc22", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "その言葉、最終判断に使える", "synthesis_text": "そのことば、さいしゅうはんだんにつかえる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v058_汗田竜司.wav" },
  { "id": "ep11_v059", "cut": "ep11_vc23", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十三レジのレシートが印字された。", "synthesis_text": "だいじゅうさんれじのれしーとがいんじされた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v059_ナレーション.wav" },
  { "id": "ep11_v060", "cut": "ep11_vc24", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはマニュアルに書いた。", "synthesis_text": "たくみワ、まにゅあるにかいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v060_ナレーション.wav" },
  { "id": "ep11_v061", "cut": "ep11_vc24", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "棚卸しは世界線より強い。今この店にあるものだけを数える。", "synthesis_text": "たなおろしワ、せかいせんよりつよい。いま、このみせにあるものだけをかぞえる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v061_ナレーション.wav" },
  { "id": "ep11_v062", "cut": "ep11_vc25", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "左右のレジは消えた。第十三レジだけが、いつもの場所に残っていた。", "synthesis_text": "さゆうのれじワ、きえた。だいじゅうさんれじだけが、いつものばしょにのこっていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v062_ナレーション.wav" },
  { "id": "ep11_v063", "cut": "ep11_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "コピー機が一枚、紙を吐き出す。", "synthesis_text": "こぴーきがいちまい、かみをはきだす。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v063_ナレーション.wav" },
  { "id": "ep11_v064", "cut": "ep11_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "明日、全部の伝票が来ます。", "synthesis_text": "あした、ぜんぶのでんぴょうがきます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v064_ナレーション.wav" },
  { "id": "ep11_v065", "cut": "ep11_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは静かにファイルを閉じた。", "synthesis_text": "たくみワ、しずかにふぁいるをとじた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v065_ナレーション.wav" },
  { "id": "ep11_v066", "cut": "ep11_vc26", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "全部って、どれですか", "synthesis_text": "ぜんぶって、どれですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v066_タクミ.wav" },
  { "id": "ep11_v067", "cut": "ep11_vc26", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "全部です", "synthesis_text": "ぜんぶです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v067_第十三レジ.wav" },
  { "id": "ep11_v068", "cut": "ep11_vc26", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "一番嫌な答えだ", "synthesis_text": "いちばんいやなこたえだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep11_voice_reading_hiragana\\clips\\ep11_v068_タクミ.wav" }
]
