[
  {
    "id": "ep01_v001",
    "cut": "ep01_001",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "午前二時三分。",
    "synthesis_text": "ごぜんにじさんぷん。",
    "start": 0.0,
    "end": 2.063,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v001_ナレーション.wav"
  },
  {
    "id": "ep01_v002",
    "cut": "ep01_002",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "国道沿いのコンビニは、冷蔵ケースの低い音だけでできているみたいに静かだった。",
    "synthesis_text": "こくどうぞいのこんびにワ、れいぞうけーすのひくいおとだけでできているみたいにしずかだった。",
    "start": 2.563,
    "end": 8.388,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v002_ナレーション.wav"
  },
  {
    "id": "ep01_v003",
    "cut": "ep01_004",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "新人夜勤バイトのタクミは、おにぎり棚の前で廃棄時間のシールを見比べていた。",
    "synthesis_text": "しんじんやきんばいとのたくみワ、おにぎりだなのまえで、はいきじかんのしーるをみくらべていた。",
    "start": 9.188,
    "end": 15.302,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v003_ナレーション.wav"
  },
  {
    "id": "ep01_v004",
    "cut": "ep01_005",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん。廃棄のおにぎりって、何分前から食べていいんですか。",
    "synthesis_text": "みなさん。はいきのおにぎりって、なんぷんまえからたべていいんですか。",
    "start": 15.802,
    "end": 20.412,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v004_タクミ.wav"
  },
  {
    "id": "ep01_v005",
    "cut": "ep01_006",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "食べていいとは言ってない。",
    "synthesis_text": "たべていいとワいってない。",
    "start": 20.712,
    "end": 22.914,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v005_ミナ.wav"
  },
  {
    "id": "ep01_v006",
    "cut": "ep01_007",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "でも捨てるんですよね。",
    "synthesis_text": "でもすてるんですよね。",
    "start": 23.264,
    "end": 25.182,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v006_タクミ.wav"
  },
  {
    "id": "ep01_v007",
    "cut": "ep01_008",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "捨てるものと食べていいものの間には、店長という深い谷がある。",
    "synthesis_text": "すてるものとたべていいもののあいだにワ、てんちょうというふかいたにがある。",
    "start": 25.432,
    "end": 31.288,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v007_ミナ.wav"
  },
  {
    "id": "ep01_v008",
    "cut": "ep01_009",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "現実的に深いですね。",
    "synthesis_text": "げんじつてきにふかいですね。",
    "start": 31.588,
    "end": 33.605,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v008_タクミ.wav"
  },
  {
    "id": "ep01_v009",
    "cut": "ep01_008",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "落ちるとシフトが減る。",
    "synthesis_text": "おちるとしふとがへる。",
    "start": 33.855,
    "end": 35.817,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v009_ミナ.wav"
  },
  {
    "id": "ep01_v010",
    "cut": "ep01_009",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "シフト減るのが一番効くやつだ。",
    "synthesis_text": "しふとへるのがいちばんきくやつだ。",
    "start": 36.117,
    "end": 38.436,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v010_タクミ.wav"
  },
  {
    "id": "ep01_v011",
    "cut": "ep01_010",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "二時十五分、雑誌返品。二時十七分、第十三レジ。",
    "synthesis_text": "にじじゅうごふん、ざっしへんぴん。にじじゅうななふん、だいじゅうさんれじ。",
    "start": 39.036,
    "end": 45.069,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v011_ミナ.wav"
  },
  {
    "id": "ep01_v012",
    "cut": "ep01_011",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "はい。……はい？",
    "synthesis_text": "はい。はい？",
    "start": 45.419,
    "end": 46.819,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v012_タクミ.wav"
  },
  {
    "id": "ep01_v014",
    "cut": "ep01_014",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "タクミが聞き返した瞬間、雑誌棚とコピー機の間に、銀色の古いレジが現れた。",
    "synthesis_text": "たくみがききかえしたしゅんかん、ざっしだなとこぴーきのあいだに、ぎんいろのふるいれじがあらわれた。",
    "start": 47.219,
    "end": 53.359,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v014_ナレーション.wav"
  },
  {
    "id": "ep01_v015",
    "cut": "ep01_015",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "第十三レジ。ただいま営業中。",
    "synthesis_text": "だいじゅうさんれじ。ただいまえいぎょうちゅう。",
    "start": 53.859,
    "end": 57.018,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v015_第十三レジ.wav"
  },
  {
    "id": "ep01_v016",
    "cut": "ep01_016",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "増えた……。",
    "synthesis_text": "ふえた。",
    "start": 57.518,
    "end": 58.52,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v016_タクミ.wav"
  },
  {
    "id": "ep01_v017",
    "cut": "ep01_017",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "増えるよ。",
    "synthesis_text": "ふえるよ。",
    "start": 58.87,
    "end": 60.276,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v017_ミナ.wav"
  },
  {
    "id": "ep01_v018",
    "cut": "ep01_018",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "コンビニって夜になるとレジが増えるんですか。",
    "synthesis_text": "こんびにってよるになるとれじがふえるんですか。",
    "start": 60.576,
    "end": 63.498,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v018_タクミ.wav"
  },
  {
    "id": "ep01_v019",
    "cut": "ep01_019",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "夜勤はだいたいそう。",
    "synthesis_text": "やきんワだいたいそう。",
    "start": 63.748,
    "end": 65.731,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v019_ミナ.wav"
  },
  {
    "id": "ep01_v020",
    "cut": "ep01_018",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "絶対違う。",
    "synthesis_text": "ぜったいちがう。",
    "start": 65.981,
    "end": 67.393,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v020_タクミ.wav"
  },
  {
    "id": "ep01_v022",
    "cut": "ep01_021",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "入ってきたのは、くたびれたスーツ姿の男だった。",
    "synthesis_text": "はいってきたのワ、くたびれたすーつすがたのおとこだった。",
    "start": 68.043,
    "end": 72.102,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v022_ナレーション.wav"
  },
  {
    "id": "ep01_v023",
    "cut": "ep01_021",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "肩の小さな液晶には、残業時間二百七十六時間、と表示されている。",
    "synthesis_text": "かたのちいさなえきしょうにワ、ざんぎょうじかんにひゃくななじゅうろくじかん、とひょうじされている。",
    "start": 72.352,
    "end": 78.212,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v023_ナレーション.wav"
  },
  {
    "id": "ep01_v024",
    "cut": "ep01_021",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "首元の透明なパッチが、レジの電子音に合わせて一度だけ銀色に光った。",
    "synthesis_text": "くびもとのとうめいなぱっちが、れじのでんしおんにあわせていちどだけぎんいろにひかった。",
    "start": 78.462,
    "end": 84.102,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v024_ナレーション.wav"
  },
  {
    "id": "ep01_v025",
    "cut": "ep01_022",
    "character": "未来の会社員",
    "speaker": "fumifumi / ノーマル",
    "text": "返品、お願いします。",
    "synthesis_text": "へんぴん、おねがいします。",
    "start": 84.602,
    "end": 86.663,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v025_未来の会社員.wav"
  },
  {
    "id": "ep01_v026",
    "cut": "ep01_023",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "レシートはお持ちですか。",
    "synthesis_text": "れしーとワおもちですか。",
    "start": 87.013,
    "end": 89.352,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v026_ミナ.wav"
  },
  {
    "id": "ep01_v027",
    "cut": "ep01_024",
    "character": "未来の会社員",
    "speaker": "fumifumi / ノーマル",
    "text": "五十年後に発行されます。",
    "synthesis_text": "ごじゅうねんごに、はっこうされます。",
    "start": 89.602,
    "end": 92.126,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v027_未来の会社員.wav"
  },
  {
    "id": "ep01_v028",
    "cut": "ep01_025",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん。対応マニュアルあります？",
    "synthesis_text": "みなさん。たいおうまにゅあるあります？",
    "start": 92.576,
    "end": 95.367,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v028_タクミ.wav"
  },
  {
    "id": "ep01_v029",
    "cut": "ep01_026",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "まず、いらっしゃいませ。",
    "synthesis_text": "まず、いらっしゃいませ。",
    "start": 95.617,
    "end": 97.85,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v029_ミナ.wav"
  },
  {
    "id": "ep01_v030",
    "cut": "ep01_025",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "そこからなんですね。",
    "synthesis_text": "そこからなんですね。",
    "start": 98.1,
    "end": 99.829,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v030_タクミ.wav"
  },
  {
    "id": "ep01_v031",
    "cut": "ep01_027",
    "character": "ナレーション",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "男は袋からおにぎりを出した。",
    "synthesis_text": "おとこワふくろからおにぎりをだした。",
