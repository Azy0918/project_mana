    "speaker_name": "まい",
    "style_name": "ノーマル",
    "style_id": 1431611904,
    "text": "入ってきたのは、くたびれたスーツ姿の男だった。",
    "synthesis_text": "はいってきたのは、くたびれたすーつすがたのおとこだった。",
