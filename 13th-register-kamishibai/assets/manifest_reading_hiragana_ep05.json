[
  { "id": "ep05_v001", "cut": "ep05_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "バックヤードの棚から、古い紙束が落ちてきた。", "synthesis_text": "ばっくやーどのたなから、ふるいかみたばがおちてきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v001_ナレーション.wav" },
  { "id": "ep05_v002", "cut": "ep05_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはそれを拾い上げた。", "synthesis_text": "たくみワ、それをひろいあげた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v002_ナレーション.wav" },
  { "id": "ep05_v003", "cut": "ep05_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "黄ばんだ手書き伝票。日付は昭和五十八年。品名は、牛乳、食パン、乾電池、謎のり弁。", "synthesis_text": "きばんだてがきでんぴょう。ひづけワ、しょうわごじゅうはちねん。ひんめいワ、ぎゅうにゅう、しょくぱん、かんでんち、なぞのりべん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v003_ナレーション.wav" },
  { "id": "ep05_v004", "cut": "ep05_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ミナさん、昔の商店の伝票みたいなのが出てきました", "synthesis_text": "みなさん、むかしのしょうてんのでんぴょうみたいなのがでてきました。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v004_タクミ.wav" },
  { "id": "ep05_v005", "cut": "ep05_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "未処理？", "synthesis_text": "みしょり？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v005_ミナ.wav" },
  { "id": "ep05_v006", "cut": "ep05_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "昭和から未処理なら、もう諦めていいのでは", "synthesis_text": "しょうわからみしょりなら、もうあきらめていいのでワ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v006_タクミ.wav" },
  { "id": "ep05_v007", "cut": "ep05_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "伝票は諦めない", "synthesis_text": "でんぴょうワ、あきらめない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v007_ミナ.wav" },
  { "id": "ep05_v008", "cut": "ep05_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "伝票側の意思が強い", "synthesis_text": "でんぴょうがわのいしがつよい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v008_タクミ.wav" },
  { "id": "ep05_v009", "cut": "ep05_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v009_ナレーション.wav" },
  { "id": "ep05_v010", "cut": "ep05_vc03", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "過去伝票を確認。読み込みを開始します", "synthesis_text": "かこでんぴょうをかくにん。よみこみをかいしします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v010_第十三レジ.wav" },
  { "id": "ep05_v011", "cut": "ep05_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "古い伝票が一枚ずつ吸い込まれていく。", "synthesis_text": "ふるいでんぴょうがいちまいずつすいこまれていく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v011_ナレーション.wav" },
  { "id": "ep05_v012", "cut": "ep05_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十三レジの液晶には、牛乳五本、食パン三斤、乾電池二個、と表示された。", "synthesis_text": "だいじゅうさんれじのえきしょうにワ、ぎゅうにゅうごほん、しょくぱんさんぎん、かんでんちにこ、とひょうじされた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v012_ナレーション.wav" },
  { "id": "ep05_v013", "cut": "ep05_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そこに突然、見慣れない文字が混ざった。", "synthesis_text": "そこにとつぜん、みなれないもじがまざった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v013_ナレーション.wav" },
  { "id": "ep05_v014", "cut": "ep05_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "記憶返品タグ、一枚。危険知識封印、未処理。開封厳禁。", "synthesis_text": "きおくへんぴんたぐ、いちまい。きけんちしきふういん、みしょり。かいふうげんきん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v014_ナレーション.wav" },
  { "id": "ep05_v015", "cut": "ep05_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは眉を寄せた。", "synthesis_text": "たくみワ、まゆをよせた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v015_ナレーション.wav" },
  { "id": "ep05_v016", "cut": "ep05_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "昭和に未来の封印記録が混ざってます", "synthesis_text": "しょうわにみらいのふういんきろくがまざってます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v016_タクミ.wav" },
  { "id": "ep05_v017", "cut": "ep05_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田がやって来た。ナビに、古紙の匂いが危険です、と出たらしい。", "synthesis_text": "あせだがやってきた。なびに、こしのにおいがきけんです、とでたらしい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v017_ナレーション.wav" },
  { "id": "ep05_v018", "cut": "ep05_vc05", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "過去に偽装された未来の記録だ", "synthesis_text": "かこにぎそうされたみらいのきろくだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v018_汗田竜司.wav" },
  { "id": "ep05_v019", "cut": "ep05_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "古紙の匂いでそこまでわかるんですか", "synthesis_text": "こしのにおいでそこまでわかるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v019_タクミ.wav" },
  { "id": "ep05_v020", "cut": "ep05_vc05", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "ナビが言った", "synthesis_text": "なびがいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v020_汗田竜司.wav" },
  { "id": "ep05_v021", "cut": "ep05_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ナビ、便利ですね", "synthesis_text": "なび、べんりですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v021_タクミ.wav" },
  { "id": "ep05_v022", "cut": "ep05_vc06", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は伝票を光に透かした。紙の繊維の間に、細い銀色の線が入っている。", "synthesis_text": "あせだワ、でんぴょうをひかりにすかした。かみのせんいのあいだに、ほそいぎんいろのせんがはいっている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v022_ナレーション.wav" },
  { "id": "ep05_v023", "cut": "ep05_vc06", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "これは単なる伝票じゃない。未来青年の記憶封印ログを、古い商店伝票に偽装してある", "synthesis_text": "これワ、たんなるでんぴょうじゃない。みらいせいねんのきおくふういんろぐを、ふるいしょうてんでんぴょうにぎそうしてある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v023_汗田竜司.wav" },
  { "id": "ep05_v024", "cut": "ep05_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは別の束を持ってきた。", "synthesis_text": "みなワ、べつのたばをもってきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v024_ナレーション.wav" },
  { "id": "ep05_v025", "cut": "ep05_vc07", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "じゃあ仕分けよう", "synthesis_text": "じゃあしわけよう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v025_ミナ.wav" },
  { "id": "ep05_v026", "cut": "ep05_vc07", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "宇宙規模の封印記録を？", "synthesis_text": "うちゅうきぼのふういんきろくを？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v026_タクミ.wav" },
  { "id": "ep05_v027", "cut": "ep05_vc07", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "伝票だから", "synthesis_text": "でんぴょうだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v027_ミナ.wav" },
  { "id": "ep05_v028", "cut": "ep05_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "作業は地味だった。牛乳。食パン。乾電池。記憶封印。のり弁。砂糖。危険知識。しょうゆ。", "synthesis_text": "さぎょうワ、じみだった。ぎゅうにゅう。しょくぱん。かんでんち。きおくふういん。のりべん。さとう。きけんちしき。しょうゆ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v028_ナレーション.wav" },
  { "id": "ep05_v029", "cut": "ep05_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは声に出して分けていく。", "synthesis_text": "たくみワ、こえにだしてわけていく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v029_ナレーション.wav" },
  { "id": "ep05_v030", "cut": "ep05_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "生活用品と未来大戦争の原因を同じ机に並べないでください", "synthesis_text": "せいかつようひんと、みらいだいせんそうのげんいんを、おなじつくえにならべないでください。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v030_タクミ.wav" },
  { "id": "ep05_v031", "cut": "ep05_vc09", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "分類精度、六十八パーセント", "synthesis_text": "ぶんるいせいど、ろくじゅうはちぱーせんと。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v031_第十三レジ.wav" },
  { "id": "ep05_v032", "cut": "ep05_vc09", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "低い！", "synthesis_text": "ひくい！", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v032_タクミ.wav" },
  { "id": "ep05_v033", "cut": "ep05_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "座木山がコピー機へ来た。", "synthesis_text": "ざきやまが、こぴーきエきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v033_ナレーション.wav" },
  { "id": "ep05_v034", "cut": "ep05_vc10", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "昔の伝票かい", "synthesis_text": "むかしのでんぴょうかい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v034_座木山辰哉.wav" },
  { "id": "ep05_v035", "cut": "ep05_vc10", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "座木山さん、これ見たことあります？", "synthesis_text": "ざきやまさん、これみたことあります？", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v035_タクミ.wav" },
  { "id": "ep05_v036", "cut": "ep05_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "座木山は黄ばんだ紙を眺めた。", "synthesis_text": "ざきやまワ、きばんだかみをながめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v036_ナレーション.wav" },
  { "id": "ep05_v037", "cut": "ep05_vc11", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "この店ができる前、ここに小さい雑貨屋があったんだ。夜中でも電池を売ってくれた", "synthesis_text": "このみせができるまえ、ここにちいさいざっかやがあったんだ。よなかでもでんちをうってくれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v037_座木山辰哉.wav" },
  { "id": "ep05_v038", "cut": "ep05_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは少しだけ静かになった。", "synthesis_text": "たくみワ、すこしだけしずかになった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v038_ナレーション.wav" },
  { "id": "ep05_v039", "cut": "ep05_vc11", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "この場所、前から夜の人を助けてたんですね", "synthesis_text": "このばしょ、まえからよるのひとをたすけてたんですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v039_タクミ.wav" },
  { "id": "ep05_v040", "cut": "ep05_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは伝票を一枚持った。", "synthesis_text": "みなワ、でんぴょうをいちまいもった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v040_ナレーション.wav" },
  { "id": "ep05_v041", "cut": "ep05_vc12", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "だから未処理は困る", "synthesis_text": "だから、みしょりワこまる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v041_ミナ.wav" },
  { "id": "ep05_v042", "cut": "ep05_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "急に経理の話に戻す", "synthesis_text": "きゅうにけいりのはなしにもどす。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v042_タクミ.wav" },
  { "id": "ep05_v043", "cut": "ep05_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "問題の伝票には、封印記録と一緒に、手書きでこう書かれていた。", "synthesis_text": "もんだいのでんぴょうにワ、ふういんきろくといっしょに、てがきでこうかかれていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v043_ナレーション.wav" },
  { "id": "ep05_v044", "cut": "ep05_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "判断できないものは、預かっておく。", "synthesis_text": "はんだんできないものワ、あずかっておく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v044_ナレーション.wav" },
  { "id": "ep05_v045", "cut": "ep05_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は低く言った。", "synthesis_text": "あせだワ、ひくくいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v045_ナレーション.wav" },
  { "id": "ep05_v046", "cut": "ep05_vc13", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "未来青年を消さずに過去へ返品した理由かもしれない", "synthesis_text": "みらいせいねんをけさずに、かこエへんぴんしたりゆうかもしれない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v046_汗田竜司.wav" },
  { "id": "ep05_v047", "cut": "ep05_vc14", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "処理選択。過去伝票として廃棄。未来記録として開封。現代店舗で一時保管", "synthesis_text": "しょりせんたく。かこでんぴょうとしてはいき。みらいきろくとしてかいふう。げんだいてんぽでいちじほかん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v047_第十三レジ.wav" },
  { "id": "ep05_v048", "cut": "ep05_vc14", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "開封はダメですよね", "synthesis_text": "かいふうワ、だめですよね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v048_タクミ.wav" },
  { "id": "ep05_v049", "cut": "ep05_vc14", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "危険知識は剥がさない", "synthesis_text": "きけんちしきワ、はがさない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v049_ミナ.wav" },
  { "id": "ep05_v050", "cut": "ep05_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは伝票に保留のハンコを押した。", "synthesis_text": "みなワ、でんぴょうにほりゅうのはんこをおした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v050_ナレーション.wav" },
  { "id": "ep05_v051", "cut": "ep05_vc15", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "現代店舗で一時保管", "synthesis_text": "げんだいてんぽで、いちじほかん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v051_ミナ.wav" },
  { "id": "ep05_v052", "cut": "ep05_vc15", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "受理しました。過去伝票、未処理から保留へ移行します", "synthesis_text": "じゅりしました。かこでんぴょう、みしょりからほりゅうエいこうします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v052_第十三レジ.wav" },
  { "id": "ep05_v053", "cut": "ep05_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは感心しかけたが、すぐにレシートを見て肩を落とした。", "synthesis_text": "たくみワ、かんしんしかけたが、すぐにれしーとをみてかたをおとした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v053_ナレーション.wav" },
  { "id": "ep05_v054", "cut": "ep05_vc16", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "背表紙まで要求されるんですか", "synthesis_text": "せびょうしまでようきゅうされるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v054_タクミ.wav" },
  { "id": "ep05_v055", "cut": "ep05_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはバックヤードの文具箱を開けた。", "synthesis_text": "みなワ、ばっくやーどのぶんぐばこをあけた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v055_ナレーション.wav" },
  { "id": "ep05_v056", "cut": "ep05_vc17", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "テプラ出す？", "synthesis_text": "てぷら、だす？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v056_ミナ.wav" },
  { "id": "ep05_v057", "cut": "ep05_vc17", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "世界を救う前にラベル作りですか", "synthesis_text": "せかいをすくうまえに、らべるづくりですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v057_タクミ.wav" },
  { "id": "ep05_v058", "cut": "ep05_vc17", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "探しやすいから", "synthesis_text": "さがしやすいから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v058_ミナ.wav" },
  { "id": "ep05_v059", "cut": "ep05_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は静かにうなずいた。", "synthesis_text": "あせだワ、しずかにうなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v059_ナレーション.wav" },
  { "id": "ep05_v060", "cut": "ep05_vc18", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "未来のシステムにも、こういう整理が必要だったのかもしれないな", "synthesis_text": "みらいのしすてむにも、こういうせいりがひつようだったのかもしれないな。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v060_汗田竜司.wav" },
  { "id": "ep05_v061", "cut": "ep05_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはマニュアルに書き足した。", "synthesis_text": "たくみワ、まにゅあるにかきたした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v061_ナレーション.wav" },
  { "id": "ep05_v062", "cut": "ep05_vc19", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "危険知識は剥がさない。古い伝票でも、未処理なら処理する。", "synthesis_text": "きけんちしきワ、はがさない。ふるいでんぴょうでも、みしょりならしょりする。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep05_voice_reading_hiragana\\clips\\ep05_v062_ナレーション.wav" }
]
