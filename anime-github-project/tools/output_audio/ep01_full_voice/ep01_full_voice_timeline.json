    "cut": "ep01_037",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "なぜ。",
    "synthesis_text": "なぜ。",
    "start": 151.52,
    "end": 152.595,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v045_タクミ.wav"
  },
  {
