[
  {
    "id": "ep01_v001",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "午前二時三分。",
    "start": 0.0,
    "end": 1.677,
    "clip": "raw/ep01_v001_ナレーション.wav"
  },
  {
    "id": "ep01_v002",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "国道沿いのコンビニは、冷蔵ケースの低い音だけでできているみたいに静かだった。",
    "start": 2.177,
    "end": 8.723,
    "clip": "raw/ep01_v002_ナレーション.wav"
  },
  {
    "id": "ep01_v003",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "新人夜勤バイトのタクミは、おにぎり棚の前で廃棄時間のシールを見比べていた。",
    "start": 9.523,
    "end": 16.285,
    "clip": "raw/ep01_v003_ナレーション.wav"
  },
  {
    "id": "ep01_v004",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん。廃棄のおにぎりって、何分前から食べていいんですか。",
    "start": 16.785,
    "end": 21.207,
    "clip": "raw/ep01_v004_タクミ.wav"
  },
  {
    "id": "ep01_v005",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "食べていいとは言ってない。",
    "start": 21.507,
    "end": 23.628,
    "clip": "raw/ep01_v005_ミナ.wav"
  },
  {
    "id": "ep01_v006",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "でも捨てるんですよね。",
    "start": 23.978,
    "end": 25.759,
    "clip": "raw/ep01_v006_タクミ.wav"
  },
  {
    "id": "ep01_v007",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "捨てるものと食べていいものの間には、店長という深い谷がある。",
    "start": 26.009,
    "end": 31.634,
    "clip": "raw/ep01_v007_ミナ.wav"
  },
  {
    "id": "ep01_v008",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "現実的に深いですね。",
    "start": 31.934,
    "end": 33.998,
    "clip": "raw/ep01_v008_タクミ.wav"
  },
  {
    "id": "ep01_v009",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "落ちるとシフトが減る。",
    "start": 34.248,
    "end": 36.317,
    "clip": "raw/ep01_v009_ミナ.wav"
  },
  {
    "id": "ep01_v010",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "地獄が給与明細に出るタイプだ。",
    "start": 36.617,
    "end": 39.23,
    "clip": "raw/ep01_v010_タクミ.wav"
  },
  {
    "id": "ep01_v011",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "二時十五分、雑誌返品。二時十七分、第十三レジ。",
    "start": 39.83,
    "end": 45.749,
    "clip": "raw/ep01_v011_ミナ.wav"
  },
  {
    "id": "ep01_v012",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "はい。……はい？",
    "start": 46.099,
    "end": 47.805,
    "clip": "raw/ep01_v012_タクミ.wav"
  },
  {
    "id": "ep01_v014",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "タクミが聞き返した瞬間、雑誌棚とコピー機の間に、銀色の古いレジが現れた。",
    "start": 48.205,
    "end": 55.591,
    "clip": "raw/ep01_v014_ナレーション.wav"
  },
  {
    "id": "ep01_v015",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "第十三レジ。ただいま営業中。",
    "start": 56.091,
    "end": 59.151,
    "clip": "raw/ep01_v015_第十三レジ.wav"
  },
  {
    "id": "ep01_v016",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "増えた……。",
    "start": 59.651,
    "end": 60.854,
    "clip": "raw/ep01_v016_タクミ.wav"
  },
  {
    "id": "ep01_v017",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "増えるよ。",
    "start": 61.204,
    "end": 62.522,
    "clip": "raw/ep01_v017_ミナ.wav"
  },
  {
    "id": "ep01_v018",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "コンビニって夜になるとレジが増えるんですか。",
    "start": 62.822,
    "end": 65.657,
    "clip": "raw/ep01_v018_タクミ.wav"
  },
  {
    "id": "ep01_v019",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "夜勤はだいたいそう。",
    "start": 65.907,
    "end": 67.775,
    "clip": "raw/ep01_v019_ミナ.wav"
  },
  {
    "id": "ep01_v020",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "絶対違う。",
    "start": 68.025,
    "end": 69.442,
    "clip": "raw/ep01_v020_タクミ.wav"
  },
  {
    "id": "ep01_v022",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "入ってきたのは、くたびれたスーツ姿の男だった。",
    "start": 70.092,
    "end": 74.568,
    "clip": "raw/ep01_v022_ナレーション.wav"
  },
  {
    "id": "ep01_v023",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "肩の小さな液晶には、残業時間二百七十六時間、と表示されている。",
    "start": 74.818,
    "end": 81.383,
    "clip": "raw/ep01_v023_ナレーション.wav"
  },
  {
    "id": "ep01_v024",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "首元の透明なパッチが、レジの電子音に合わせて一度だけ銀色に光った。",
    "start": 81.633,
    "end": 88.245,
    "clip": "raw/ep01_v024_ナレーション.wav"
  },
  {
    "id": "ep01_v025",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "返品、お願いします。",
    "start": 88.745,
    "end": 90.849,
    "clip": "raw/ep01_v025_未来の会社員.wav"
  },
  {
    "id": "ep01_v026",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "レシートはお持ちですか。",
    "start": 91.199,
    "end": 93.385,
    "clip": "raw/ep01_v026_ミナ.wav"
  },
  {
    "id": "ep01_v027",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "五十年後に発行されます。",
    "start": 93.635,
    "end": 96.087,
    "clip": "raw/ep01_v027_未来の会社員.wav"
  },
  {
    "id": "ep01_v028",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん。対応マニュアルあります？",
    "start": 96.537,
    "end": 99.149,
    "clip": "raw/ep01_v028_タクミ.wav"
  },
  {
    "id": "ep01_v029",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "まず、いらっしゃいませ。",
    "start": 99.399,
    "end": 101.752,
    "clip": "raw/ep01_v029_ミナ.wav"
  },
  {
    "id": "ep01_v030",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "そこからなんですね。",
    "start": 102.002,
    "end": 103.7,
    "clip": "raw/ep01_v030_タクミ.wav"
  },
  {
    "id": "ep01_v031",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "男は袋からおにぎりを出した。",
    "start": 104.2,
    "end": 107.349,
    "clip": "raw/ep01_v031_ナレーション.wav"
  },
  {
    "id": "ep01_v032",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "パッケージには、完全栄養おにぎり・思い出の鮭。",
    "start": 107.549,
    "end": 112.149,
    "clip": "raw/ep01_v032_ナレーション.wav"
  },
  {
    "id": "ep01_v033",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "製造年月日、二〇七四年六月十二日。",
    "start": 112.399,
    "end": 117.279,
    "clip": "raw/ep01_v033_ナレーション.wav"
  },
  {
    "id": "ep01_v034",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "警告。この商品は未来の食糧危機解決候補です。",
    "start": 117.779,
    "end": 122.002,
    "clip": "raw/ep01_v034_第十三レジ.wav"
  },
  {
    "id": "ep01_v035",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "誤返品により人類生存率が三・二パーセント低下します。",
    "start": 122.202,
    "end": 127.485,
    "clip": "raw/ep01_v035_第十三レジ.wav"
  },
  {
    "id": "ep01_v036",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん、僕の時給で扱っていい数字じゃないです。",
    "start": 127.935,
    "end": 131.548,
    "clip": "raw/ep01_v036_タクミ.wav"
  },
  {
    "id": "ep01_v037",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "うちの課が試験販売前の商品を過去へ誤配送しまして。",
    "start": 131.998,
    "end": 136.472,
    "clip": "raw/ep01_v037_未来の会社員.wav"
  },
  {
    "id": "ep01_v038",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "返品しないと始末書が増えます。",
    "start": 136.722,
    "end": 139.329,
    "clip": "raw/ep01_v038_未来の会社員.wav"
  },
  {
    "id": "ep01_v039",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "人類より始末書を気にしてる。",
    "start": 139.629,
    "end": 141.764,
    "clip": "raw/ep01_v039_タクミ.wav"
  },
  {
    "id": "ep01_v040",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "会社員なので。",
    "start": 142.014,
    "end": 143.872,
    "clip": "raw/ep01_v040_未来の会社員.wav"
  },
  {
    "id": "ep01_v041",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "説得力が嫌だ。",
    "start": 144.122,
    "end": 145.838,
    "clip": "raw/ep01_v041_タクミ.wav"
  },
  {
    "id": "ep01_v042",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "第十三レジの画面には、通常返品、時空返品、存在取消、温める、店長呼出、と並んでいた。",
    "start": 146.388,
    "end": 156.849,
    "clip": "raw/ep01_v042_ナレーション.wav"
  },
  {
    "id": "ep01_v043",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "店長呼出があります。",
    "start": 157.199,
    "end": 158.972,
    "clip": "raw/ep01_v043_タクミ.wav"
  },
  {
    "id": "ep01_v044",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "押さない。",
    "start": 159.172,
    "end": 160.426,
    "clip": "raw/ep01_v044_ミナ.wav"
  },
  {
    "id": "ep01_v045",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "なぜ。",
    "start": 160.626,
    "end": 161.655,
    "clip": "raw/ep01_v045_タクミ.wav"
  },
  {
    "id": "ep01_v046",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "二時以降は出ない。",
    "start": 161.805,
    "end": 163.686,
    "clip": "raw/ep01_v046_ミナ.wav"
  },
  {
    "id": "ep01_v047",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "店長呼出の存在意義。",
    "start": 163.886,
    "end": 165.882,
    "clip": "raw/ep01_v047_タクミ.wav"
  },
  {
    "id": "ep01_v048",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "残り時間、三分。",
    "start": 166.332,
    "end": 167.96,
    "clip": "raw/ep01_v048_第十三レジ.wav"
  },
  {
    "id": "ep01_v049",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "二時二十分を過ぎると、この商品は現代店舗の新商品として定着します。",
    "start": 168.16,
    "end": 174.667,
    "clip": "raw/ep01_v049_第十三レジ.wav"
  },
  {
    "id": "ep01_v050",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "仕入れ原価、一個七万二千円。",
    "start": 174.867,
    "end": 177.544,
    "clip": "raw/ep01_v050_第十三レジ.wav"
  },
  {
    "id": "ep01_v051",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "返品しましょう。",
    "start": 177.894,
    "end": 179.305,
    "clip": "raw/ep01_v051_タクミ.wav"
  },
  {
    "id": "ep01_v052",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "こちらの商品、温めますか。",
    "start": 179.655,
    "end": 183.059,
    "clip": "raw/ep01_v052_ミナ.wav"
  },
  {
    "id": "ep01_v053",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "この状況で！？",
    "start": 183.309,
    "end": 184.661,
    "clip": "raw/ep01_v053_タクミ.wav"
  },
  {
    "id": "ep01_v054",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "お願いします。",
    "start": 184.911,
    "end": 186.495,
    "clip": "raw/ep01_v054_未来の会社員.wav"
  },
  {
    "id": "ep01_v055",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "お願いしますじゃないですよ。",
    "start": 186.745,
    "end": 188.7,
    "clip": "raw/ep01_v055_タクミ.wav"
  },
  {
    "id": "ep01_v056",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "世界の分岐を電子レンジに入れないでください。",
    "start": 188.85,
    "end": 191.765,
    "clip": "raw/ep01_v056_タクミ.wav"
  },
  {
    "id": "ep01_v058",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "おにぎりが淡く光り、未来の食堂が映った。",
    "start": 192.165,
    "end": 196.363,
    "clip": "raw/ep01_v058_ナレーション.wav"
  },
  {
    "id": "ep01_v059",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "空っぽの棚。長い列。",
    "start": 196.713,
    "end": 199.522,
    "clip": "raw/ep01_v059_ナレーション.wav"
  },
  {
    "id": "ep01_v060",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "小さな子どもが、そのおにぎりを両手で持って笑っている。",
    "start": 199.822,
    "end": 204.574,
    "clip": "raw/ep01_v060_ナレーション.wav"
  },
  {
    "id": "ep01_v061",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "未来の会社員は息を呑んだ。",
    "start": 205.174,
    "end": 207.796,
    "clip": "raw/ep01_v061_ナレーション.wav"
  },
  {
    "id": "ep01_v062",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "開発記録です。これが、ちゃんと届けば……。",
    "start": 207.996,
    "end": 211.919,
    "clip": "raw/ep01_v062_未来の会社員.wav"
  },
  {
    "id": "ep01_v063",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "加熱により時空状態が安定しました。",
    "start": 212.519,
    "end": 216.012,
    "clip": "raw/ep01_v063_第十三レジ.wav"
  },
  {
    "id": "ep01_v064",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "履歴メモを入力してください。",
    "start": 216.212,
    "end": 218.612,
    "clip": "raw/ep01_v064_第十三レジ.wav"
  },
  {
    "id": "ep01_v065",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "このおにぎりは、ちゃんと作った方がいいです。",
    "start": 218.962,
    "end": 222.676,
    "clip": "raw/ep01_v065_ミナ.wav"
  },
  {
    "id": "ep01_v066",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ざっくり！",
    "start": 223.026,
    "end": 224.185,
    "clip": "raw/ep01_v066_タクミ.wav"
  },
  {
    "id": "ep01_v067",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "記録しました。",
    "start": 224.385,
    "end": 225.732,
    "clip": "raw/ep01_v067_第十三レジ.wav"
  },
  {
    "id": "ep01_v068",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "通るんだ！",
    "start": 225.932,
    "end": 226.998,
    "clip": "raw/ep01_v068_タクミ.wav"
  },
  {
    "id": "ep01_v069",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "未来とは、だいたい雑なメモの積み重ねです。",
    "start": 227.248,
    "end": 231.406,
    "clip": "raw/ep01_v069_第十三レジ.wav"
  },
  {
    "id": "ep01_v070",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "時空返品が完了し、返金額は百六十八円。",
    "start": 232.006,
    "end": 236.96,
    "clip": "raw/ep01_v070_ナレーション.wav"
  },
  {
    "id": "ep01_v071",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "未来の会社員は現金で受け取り、さらにホットコーヒーを買った。",
    "start": 237.21,
    "end": 242.766,
    "clip": "raw/ep01_v071_ナレーション.wav"
  },
  {
    "id": "ep01_v072",
    "character": "未来の会社員",
    "speaker": "澤原 玄二郎 / ノーマル",
    "text": "未来のコーヒー、高いので。",
    "start": 243.066,
    "end": 245.589,
    "clip": "raw/ep01_v072_未来の会社員.wav"
  },
  {
    "id": "ep01_v073",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "未来、行きたくないな。",
    "start": 245.839,
    "end": 247.919,
    "clip": "raw/ep01_v073_タクミ.wav"
  },
  {
    "id": "ep01_v074",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "午前二時二十分。第十三レジは消えた。",
    "start": 248.519,
    "end": 252.572,
    "clip": "raw/ep01_v074_ナレーション.wav"
  },
  {
    "id": "ep01_v075",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "残ったレシートには、こう印字されていた。",
    "start": 252.972,
    "end": 256.849,
    "clip": "raw/ep01_v075_ナレーション.wav"
  },
  {
    "id": "ep01_v076",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "時空返品、一件。歴史メモ、一件。完全栄養おにぎり、開発継続。",
    "start": 257.149,
    "end": 264.246,
    "clip": "raw/ep01_v076_ナレーション.wav"
  },
  {
    "id": "ep01_v077",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "人類生存率、微増。ホットコーヒー、レギュラー、一件。",
    "start": 264.446,
    "end": 269.579,
    "clip": "raw/ep01_v077_ナレーション.wav"
  },
  {
    "id": "ep01_v078",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "スタッフ割引、対象外。",
    "start": 269.779,
    "end": 272.618,
    "clip": "raw/ep01_v078_ナレーション.wav"
  },
  {
    "id": "ep01_v079",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "最後が一番現実的だ。",
    "start": 272.968,
    "end": 274.925,
    "clip": "raw/ep01_v079_タクミ.wav"
  },
  {
    "id": "ep01_v081",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "近所の常連らしい男がコピー機へ向かった。",
    "start": 275.575,
    "end": 279.443,
    "clip": "raw/ep01_v081_ナレーション.wav"
  },
  {
    "id": "ep01_v082",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "座木山辰哉、五十五歳。眠そうな顔で、古いツーリング地図を抱えている。",
    "start": 279.693,
    "end": 286.942,
    "clip": "raw/ep01_v082_ナレーション.wav"
  },
  {
    "id": "ep01_v083",
    "character": "座木山辰哉",
    "speaker": "TANAKA / ノーマル",
    "text": "コピー、白黒でいいよ。色がつくと記憶が増えるから。",
    "start": 287.342,
    "end": 292.954,
    "clip": "raw/ep01_v083_座木山辰哉.wav"
  },
  {
    "id": "ep01_v084",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "この店、普通のお客さんも変なんですか。",
    "start": 293.454,
    "end": 296.35,
    "clip": "raw/ep01_v084_タクミ.wav"
  },
  {
    "id": "ep01_v085",
    "character": "ミナ",
    "speaker": "中2 / ノーマル",
    "text": "夜勤だから。",
    "start": 296.6,
    "end": 298.074,
    "clip": "raw/ep01_v085_ミナ.wav"
  },
  {
    "id": "ep01_v086",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "世界が少しだけ救われても、夜勤は終わらない。",
    "start": 298.774,
    "end": 303.136,
    "clip": "raw/ep01_v086_ナレーション.wav"
  },
  {
    "id": "ep01_v087",
    "character": "ナレーション",
    "speaker": "まい / ノーマル",
    "text": "床清掃も、雑誌返品も、廃棄登録も、まだ残っている。",
    "start": 303.486,
    "end": 309.511,
    "clip": "raw/ep01_v087_ナレーション.wav"
  }
]