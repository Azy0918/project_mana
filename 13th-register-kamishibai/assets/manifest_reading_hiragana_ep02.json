    "cut": "ep02_vc01",
    "character": "汗田竜司",
    "speaker_name": "阿井田 茂",
    "style_name": "ノーマル",
    "style_id": 1310138976,
    "text": "「面白いけど、すぐ利益になるの？」……か。",
    "synthesis_text": "おもしろいけど、すぐりえきになるの？……か。",
    "synthesis_source": "reading_hiragana",
    "pause_after_ms": 350,
    "clip": "outputs\\ep02_voice_reading_hiragana\\clips\\ep02_v004_汗田竜司.wav"
  },
  {
