[
  { "id": "ep12_v001", "cut": "ep12_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時零分。国道沿いのコンビニは、いつもより静かだった。", "synthesis_text": "ごぜんにじれいふん。こくどうぞいのこんびにワ、いつもよりしずかだった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v001_ナレーション.wav" },
  { "id": "ep12_v002", "cut": "ep12_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "静かすぎて、冷蔵ケースの音まで緊張しているように聞こえた。", "synthesis_text": "しずかすぎて、れいぞうけーすのおとまで、きんちょうしているようにきこえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v002_ナレーション.wav" },
  { "id": "ep12_v003", "cut": "ep12_vc02", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはバックヤードのノートを開いた。", "synthesis_text": "たくみワ、ばっくやーどののーとをひらいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v003_ナレーション.wav" },
  { "id": "ep12_v004", "cut": "ep12_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "まず、いらっしゃいませと言う。レシートを確認する。温めるか聞く。時間は袋分けできる場合がある。", "synthesis_text": "まず、いらっしゃいませという。れしーとをかくにんする。あたためるかきく。じかんワ、ふくろわけできるばあいがある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v004_ナレーション.wav" },
  { "id": "ep12_v005", "cut": "ep12_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "宇宙宅配便も受取番号が必要。危険知識は剥がさない。店長確認は基本つながらない。判断できないものは保留。", "synthesis_text": "うちゅうたくはいびんも、うけとりばんごうがひつよう。きけんちしきワ、はがさない。てんちょうかくにんワ、きほんつながらない。はんだんできないものワ、ほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v005_ナレーション.wav" },
  { "id": "ep12_v006", "cut": "ep12_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "棚卸しは世界線より強い。未来大戦争でも現金過不足は出さない。コピー機の予告は半分だけ信じる。夜勤は終わらない。", "synthesis_text": "たなおろしワ、せかいせんよりつよい。みらいだいせんそうでも、げんきんかふそくワださない。こぴーきのよこくワ、はんぶんだけしんじる。やきんワ、おわらない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v006_ナレーション.wav" },
  { "id": "ep12_v007", "cut": "ep12_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "マニュアルが宗教みたいになってきた", "synthesis_text": "まにゅあるが、しゅうきょうみたいになってきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v007_タクミ.wav" },
  { "id": "ep12_v008", "cut": "ep12_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはレジ締めの準備をしながら言った。", "synthesis_text": "みなワ、れじじめのじゅんびをしながらいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v008_ナレーション.wav" },
  { "id": "ep12_v009", "cut": "ep12_vc04", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "役に立つよ", "synthesis_text": "やくにたつよ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v009_ミナ.wav" },
  { "id": "ep12_v010", "cut": "ep12_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "役に立つ状況にいたくないです", "synthesis_text": "やくにたつじょうきょうに、いたくないです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v010_タクミ.wav" },
  { "id": "ep12_v011", "cut": "ep12_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "未来青年はイートインの端にいた。首元の記憶返品タグは、今にも剥がれそうに光っている。", "synthesis_text": "みらいせいねんワ、いーといんのはしにいた。くびもとのきおくへんぴんたぐワ、いまにもはがれそうにひかっている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v011_ナレーション.wav" },
  { "id": "ep12_v012", "cut": "ep12_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はナビ端末をカウンターに置いた。唐沢は巡回の名目で来て、現金過不足表を見ている。座木山はコピー機の前で、古い地図を広げていた。", "synthesis_text": "あせだワ、なびたんまつをかうんたーにおいた。からさわワ、じゅんかいのめいもくできて、げんきんかふそくひょうをみている。ざきやまワ、こぴーきのまえで、ふるいちずをひろげていた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v012_ナレーション.wav" },
  { "id": "ep12_v013", "cut": "ep12_vc06", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "今日は人が多いですね", "synthesis_text": "きょうワ、ひとがおおいですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v013_タクミ.wav" },
  { "id": "ep12_v014", "cut": "ep12_vc06", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "全員、たぶん必要", "synthesis_text": "ぜんいん、たぶんひつよう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v014_ミナ.wav" },
  { "id": "ep12_v015", "cut": "ep12_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v015_ナレーション.wav" },
  { "id": "ep12_v016", "cut": "ep12_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "同時に、コピー機、発注端末、宅配端末、ホットスナックケース、廃棄ボックスが一斉に鳴った。", "synthesis_text": "どうじに、こぴーき、はっちゅうたんまつ、たくはいたんまつ、ほっとすなっくけーす、はいきぼっくすが、いっせいになった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v016_ナレーション.wav" },
  { "id": "ep12_v017", "cut": "ep12_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "未来、過去、宇宙、パラレルワールドの伝票が、雪みたいに降ってくる。", "synthesis_text": "みらい、かこ、うちゅう、ぱられるわーるどのでんぴょうが、ゆきみたいにふってくる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v017_ナレーション.wav" },
  { "id": "ep12_v018", "cut": "ep12_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "完全栄養おにぎり。昨日バニラ。昭和伝票。賞味期限未成立パン。宇宙宅配便。", "synthesis_text": "かんぜんえいようおにぎり。きのうばにら。しょうわでんぴょう。しょうみきげんみせいりつぱん。うちゅうたくはいびん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v018_ナレーション.wav" },
  { "id": "ep12_v019", "cut": "ep12_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "酸素グミ。銀河ポイント。第十二レジ記録。第十四レジ記録。未来青年の封印タグ。", "synthesis_text": "さんそぐみ。ぎんがぽいんと。だいじゅうにれじきろく。だいじゅうよんれじきろく。みらいせいねんのふういんたぐ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v019_ナレーション.wav" },
  { "id": "ep12_v020", "cut": "ep12_vc10", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "最終処理を開始します。選択肢。削除。未来へ返品。銀河流通監査局へ返送。現代店舗で保留", "synthesis_text": "さいしゅうしょりをかいしします。せんたくし。さくじょ。みらいエへんぴん。ぎんがりゅうつうかんさきょくエへんそう。げんだいてんぽでほりゅう。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v020_第十三レジ.wav" },
  { "id": "ep12_v021", "cut": "ep12_vc11", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "未来青年は震える声で言った。", "synthesis_text": "みらいせいねんワ、ふるえるこえでいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v021_ナレーション.wav" },
  { "id": "ep12_v022", "cut": "ep12_vc11", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "未来へ戻れば、私は全部思い出すんですか", "synthesis_text": "みらいエもどれば、わたしワ、ぜんぶおもいだすんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v022_未来の会社員.wav" },
  { "id": "ep12_v023", "cut": "ep12_vc11", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "はい。食糧不足を救う知識と、物流戦争を起こす知識が同時に復元されます", "synthesis_text": "はい。しょくりょうぶそくをすくうちしきと、ぶつりゅうせんそうをおこすちしきが、どうじにふくげんされます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v023_第十三レジ.wav" },
  { "id": "ep12_v024", "cut": "ep12_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "削除したら？", "synthesis_text": "さくじょしたら？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v024_タクミ.wav" },
  { "id": "ep12_v025", "cut": "ep12_vc12", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "危険は消えます。救える未来も消えます", "synthesis_text": "きけんワ、きえます。すくえるみらいも、きえます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v025_第十三レジ.wav" },
  { "id": "ep12_v026", "cut": "ep12_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は静かに言った。", "synthesis_text": "あせだワ、しずかにいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v026_ナレーション.wav" },
  { "id": "ep12_v027", "cut": "ep12_vc13", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "技術も人間も、廃棄か返品だけで扱うものじゃない", "synthesis_text": "ぎじゅつもにんげんも、はいきかへんぴんだけであつかうものじゃない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v027_汗田竜司.wav" },
  { "id": "ep12_v028", "cut": "ep12_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "銀河流通監査局の通知がコピー機から出た。", "synthesis_text": "ぎんがりゅうつうかんさきょくのつうちが、こぴーきからでた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v028_ナレーション.wav" },
  { "id": "ep12_v029", "cut": "ep12_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "危険知識保持者を返送してください。処理遅延は監査対象です。店内BGMがまだ眠いです。", "synthesis_text": "きけんちしきほじしゃをへんそうしてください。しょりちえんワ、かんさたいしょうです。てんないびーじーえむが、まだねむいです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v029_ナレーション.wav" },
  { "id": "ep12_v030", "cut": "ep12_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは紙を握った。", "synthesis_text": "たくみワ、かみをにぎった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v030_ナレーション.wav" },
  { "id": "ep12_v031", "cut": "ep12_vc15", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "最後の指摘、今日はいらない", "synthesis_text": "さいごのしてき、きょうワいらない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v031_タクミ.wav" },
  { "id": "ep12_v032", "cut": "ep12_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は現金表を見ながら言った。", "synthesis_text": "からさわワ、げんきんひょうをみながらいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v032_ナレーション.wav" },
  { "id": "ep12_v033", "cut": "ep12_vc16", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "数字が合わないものは、まず保留です。あと、現金過不足はゼロでお願いします", "synthesis_text": "すうじがあわないものワ、まずほりゅうです。あと、げんきんかふそくワ、ぜろでおねがいします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v033_唐沢栄治.wav" },
  { "id": "ep12_v034", "cut": "ep12_vc16", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "未来大戦争の前でもそこなんですね", "synthesis_text": "みらいだいせんそうのまえでも、そこなんですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v034_タクミ.wav" },
  { "id": "ep12_v035", "cut": "ep12_vc16", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "監査で見ます", "synthesis_text": "かんさでみます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v035_唐沢栄治.wav" },
  { "id": "ep12_v036", "cut": "ep12_vc17", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "残り時間、一分", "synthesis_text": "のこりじかん、いっぷん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v036_第十三レジ.wav" },
  { "id": "ep12_v037", "cut": "ep12_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは未来青年を見た。", "synthesis_text": "みなワ、みらいせいねんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v037_ナレーション.wav" },
  { "id": "ep12_v038", "cut": "ep12_vc18", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "レシートはある", "synthesis_text": "れしーとワ、ある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v038_ミナ.wav" },
  { "id": "ep12_v039", "cut": "ep12_vc18", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは頷いた。", "synthesis_text": "たくみワ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v039_ナレーション.wav" },
  { "id": "ep12_v040", "cut": "ep12_vc18", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "本人確認済みです", "synthesis_text": "ほんにんかくにんずみです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v040_タクミ.wav" },
  { "id": "ep12_v041", "cut": "ep12_vc19", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "危険知識は？", "synthesis_text": "きけんちしきワ？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v041_ミナ.wav" },
  { "id": "ep12_v042", "cut": "ep12_vc19", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "剥がしません", "synthesis_text": "はがしません。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v042_タクミ.wav" },
  { "id": "ep12_v043", "cut": "ep12_vc19", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "判断は？", "synthesis_text": "はんだんワ？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v043_ミナ.wav" },
  { "id": "ep12_v044", "cut": "ep12_vc19", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "できません", "synthesis_text": "できません。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v044_タクミ.wav" },
  { "id": "ep12_v045", "cut": "ep12_vc19", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "じゃあ", "synthesis_text": "じゃあ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v045_ミナ.wav" },
  { "id": "ep12_v046", "cut": "ep12_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは自然に答えた。", "synthesis_text": "たくみワ、しぜんにこたえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v046_ナレーション.wav" },
  { "id": "ep12_v047", "cut": "ep12_vc20", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "保留です", "synthesis_text": "ほりゅうです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v047_タクミ.wav" },
  { "id": "ep12_v048", "cut": "ep12_vc20", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナが少しだけ笑った。", "synthesis_text": "みなが、すこしだけわらった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v048_ナレーション.wav" },
  { "id": "ep12_v049", "cut": "ep12_vc20", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "育った", "synthesis_text": "そだった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v049_ミナ.wav" },
  { "id": "ep12_v050", "cut": "ep12_vc20", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "嫌な方向に！", "synthesis_text": "いやなほうこうに！", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v050_タクミ.wav" },
  { "id": "ep12_v051", "cut": "ep12_vc21", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは第十三レジの画面で、現代店舗で保留、を押した。", "synthesis_text": "みなワ、だいじゅうさんれじのがめんで、げんだいてんぽでほりゅう、をおした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v051_ナレーション.wav" },
  { "id": "ep12_v052", "cut": "ep12_vc21", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "確認。危険知識保持者を現代保留にします。未来大戦争、発生保留。完全栄養おにぎり、開発継続", "synthesis_text": "かくにん。きけんちしきほじしゃを、げんだいほりゅうにします。みらいだいせんそう、はっせいほりゅう。かんぜんえいようおにぎり、かいはつけいぞく。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v052_第十三レジ.wav" },
  { "id": "ep12_v053", "cut": "ep12_vc22", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "店内の空気が大きく揺れた。ホットスナックケースの銀河標準からあげが一瞬だけ光り、廃棄ボックスの中で、廃棄予定の未来、と書かれた紙が静かに折り畳まれた。", "synthesis_text": "てんないのくうきが、おおきくゆれた。ほっとすなっくけーすのぎんがひょうじゅんからあげがいっしゅんだけひかり、はいきぼっくすのなかで、はいきよていのみらい、とかかれたかみが、しずかにおりたたまれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v053_ナレーション.wav" },
  { "id": "ep12_v054", "cut": "ep12_vc22", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "青年の首元のタグは剥がれず、透明なまま安定した。", "synthesis_text": "せいねんのくびもとのたぐワ、はがれず、とうめいなまま、あんていした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v054_ナレーション.wav" },
  { "id": "ep12_v055", "cut": "ep12_vc23", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "私は……ここにいていいんですか", "synthesis_text": "わたしワ……ここにいていいんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v055_未来の会社員.wav" },
  { "id": "ep12_v056", "cut": "ep12_vc23", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは言った。", "synthesis_text": "みなワ、いった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v056_ナレーション.wav" },
  { "id": "ep12_v057", "cut": "ep12_vc23", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "店長確認待ち", "synthesis_text": "てんちょうかくにんまち。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v057_ミナ.wav" },
  { "id": "ep12_v058", "cut": "ep12_vc23", "character": "未来の会社員", "speaker_name": "fumifumi", "style_name": "ノーマル", "style_id": 606865152, "text": "それ、いいんですか", "synthesis_text": "それ、いいんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v058_未来の会社員.wav" },
  { "id": "ep12_v059", "cut": "ep12_vc23", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは深くうなずいた。", "synthesis_text": "たくみワ、ふかくうなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v059_ナレーション.wav" },
  { "id": "ep12_v060", "cut": "ep12_vc23", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "この店では、かなり強い状態です", "synthesis_text": "このみせでワ、かなりつよいじょうたいです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v060_タクミ.wav" },
  { "id": "ep12_v061", "cut": "ep12_vc24", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は青年にコーヒーを渡した。", "synthesis_text": "あせだワ、せいねんにこーひーをわたした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v061_ナレーション.wav" },
  { "id": "ep12_v062", "cut": "ep12_vc24", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "未来は一気には変わらない。少しずつだ", "synthesis_text": "みらいワ、いっきにワかわらない。すこしずつだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v062_汗田竜司.wav" },
  { "id": "ep12_v063", "cut": "ep12_vc25", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十三レジが最後のレシートを印字した。", "synthesis_text": "だいじゅうさんれじが、さいごのれしーとをいんじした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v063_ナレーション.wav" },
  { "id": "ep12_v064", "cut": "ep12_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミはレシートを見つめた。", "synthesis_text": "たくみワ、れしーとをみつめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v064_ナレーション.wav" },
  { "id": "ep12_v065", "cut": "ep12_vc26", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "未来大戦争を店長確認に回した……", "synthesis_text": "みらいだいせんそうを、てんちょうかくにんにまわした……。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v065_タクミ.wav" },
  { "id": "ep12_v066", "cut": "ep12_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはレジ締め表を閉じた。", "synthesis_text": "みなワ、れじじめひょうをとじた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v066_ナレーション.wav" },
  { "id": "ep12_v067", "cut": "ep12_vc26", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "大事なことだから", "synthesis_text": "だいじなことだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v067_ミナ.wav" },
  { "id": "ep12_v068", "cut": "ep12_vc26", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は苦笑した。", "synthesis_text": "あせだワ、くしょうした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v068_ナレーション.wav" },
  { "id": "ep12_v069", "cut": "ep12_vc26", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "ある意味、もっとも安全な処理だ", "synthesis_text": "あるいみ、もっともあんぜんなしょりだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v069_汗田竜司.wav" },
  { "id": "ep12_v070", "cut": "ep12_vc27", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "午前二時二十分。第十三レジは消えた。", "synthesis_text": "ごぜんにじにじゅっぷん。だいじゅうさんれじワ、きえた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v070_ナレーション.wav" },
  { "id": "ep12_v071", "cut": "ep12_vc27", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "店内には、いつものコンビニの音が戻った。冷蔵ケース。自動ドア。小さな電子音。", "synthesis_text": "てんないにワ、いつものこんびにのおとがもどった。れいぞうけーす。じどうどあ。ちいさなでんしおん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v071_ナレーション.wav" },
  { "id": "ep12_v072", "cut": "ep12_vc28", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "自動ドアが開いた。座木山がコピー機の前で手を挙げる。", "synthesis_text": "じどうどあがひらいた。ざきやまが、こぴーきのまえでてをあげる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v072_ナレーション.wav" },
  { "id": "ep12_v073", "cut": "ep12_vc28", "character": "座木山辰哉", "speaker_name": "TANAKA", "style_name": "ノーマル", "style_id": 1628969216, "text": "コピー、使えるかい", "synthesis_text": "こぴー、つかえるかい。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v073_座木山辰哉.wav" },
  { "id": "ep12_v074", "cut": "ep12_vc28", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは反射的に言った。", "synthesis_text": "たくみワ、はんしゃてきにいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v074_ナレーション.wav" },
  { "id": "ep12_v075", "cut": "ep12_vc28", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "いらっしゃいませ。普通のコピーですよね？", "synthesis_text": "いらっしゃいませ。ふつうのこぴーですよね？", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v075_タクミ.wav" },
  { "id": "ep12_v076", "cut": "ep12_vc29", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "コピー機が鳴った。", "synthesis_text": "こぴーきがなった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v076_ナレーション.wav" },
  { "id": "ep12_v077", "cut": "ep12_vc29", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ウィーン。", "synthesis_text": "うぃーん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v077_ナレーション.wav" },
  { "id": "ep12_v078", "cut": "ep12_vc29", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは天井を見上げた。", "synthesis_text": "たくみワ、てんじょうをみあげた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v078_ナレーション.wav" },
  { "id": "ep12_v079", "cut": "ep12_vc29", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "普通じゃない音がした！", "synthesis_text": "ふつうじゃないおとがした！", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v079_タクミ.wav" },
  { "id": "ep12_v080", "cut": "ep12_vc30", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはモップを手に取った。", "synthesis_text": "みなワ、もっぷをてにとった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v080_ナレーション.wav" },
  { "id": "ep12_v081", "cut": "ep12_vc30", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "夜勤だから", "synthesis_text": "やきんだから。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v081_ミナ.wav" },
  { "id": "ep12_v082", "cut": "ep12_vc31", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは最後の一行をマニュアルに書いた。", "synthesis_text": "たくみワ、さいごのいちぎょうをまにゅあるにかいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v082_ナレーション.wav" },
  { "id": "ep12_v083", "cut": "ep12_vc31", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "夜勤は終わらない。", "synthesis_text": "やきんワ、おわらない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 600, "clip": "outputs\\ep12_voice_reading_hiragana\\clips\\ep12_v083_ナレーション.wav" },
