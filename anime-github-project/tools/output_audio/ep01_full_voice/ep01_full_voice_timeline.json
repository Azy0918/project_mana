  },
  {
    "id": "ep01_v035",
    "cut": "ep01_030",
    "character": "第十三レジ",
    "speaker": "ろてじん（匿名インタビュー風） / ノーマル",
    "text": "誤返品により人類生存率が三・二パーセント低下します。",
    "synthesis_text": "ごへんぴんによりじんるいせいぞんりつがさんてんにぱーせんとていかします。",
    "start": 117.143,
    "end": 121.635,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v035_第十三レジ.wav"
  },
  {
    "id": "ep01_v036",
    "cut": "ep01_031",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "ミナさん、僕の時給で扱っていい数字じゃないです。",
    "synthesis_text": "みなさん、ぼくのじきゅうであつかっていいすうじじゃないです。",
    "start": 122.085,
    "end": 125.61,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v036_タクミ.wav"
  },
  {
    "id": "ep01_v037",
    "cut": "ep01_032",
    "character": "未来の会社員",
    "speaker": "fumifumi / ノーマル",
    "text": "うちの課が試験販売前の商品を過去へ誤配送しまして。",
    "synthesis_text": "うちのかがしけんはんばいまえのしょうひんをかこエごはいそうしまして。",
    "start": 126.06,
    "end": 129.966,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v037_未来の会社員.wav"
  },
  {
    "id": "ep01_v038",
    "cut": "ep01_033",
    "character": "未来の会社員",
    "speaker": "fumifumi / ノーマル",
    "text": "返品しないと始末書が増えます。",
    "synthesis_text": "へんぴんしないとしまつしょがふえます。",
    "start": 130.216,
    "end": 132.67,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v038_未来の会社員.wav"
  },
  {
    "id": "ep01_v039",
    "cut": "ep01_034",
    "character": "タクミ",
    "speaker": "にせ / ノーマル",
    "text": "人類より始末書を気にしてる。",
    "synthesis_text": "じんるいよりしまつしょをきにしてる。",
    "start": 132.97,
    "end": 135.307,
    "clip": "outputs/ep01_voice_reading_hiragana/clips/ep01_v039_タクミ.wav"
  },
  {
    "id": "ep01_v040",
    "cut": "ep01_035",
    "character": "未来の会社員",
    "speaker": "fumifumi / ノーマル",
    "text": "会社員なので。",
