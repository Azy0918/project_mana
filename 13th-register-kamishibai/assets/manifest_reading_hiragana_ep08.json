[
  { "id": "ep08_v001", "cut": "ep08_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "発注端末が、午前二時十二分に震え始めた。", "synthesis_text": "はっちゅうたんまつが、ごぜんにじじゅうにふんにふるえはじめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v001_ナレーション.wav" },
  { "id": "ep08_v002", "cut": "ep08_vc01", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミが画面を見ると、酸素グミ、一万個、と表示されている。", "synthesis_text": "たくみががめんをみると、さんそぐみ、いちまんこ、とひょうじされている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v002_ナレーション.wav" },
  { "id": "ep08_v003", "cut": "ep08_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "ミナさん。酸素グミって何ですか", "synthesis_text": "みなさん。さんそぐみって、なんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v003_タクミ.wav" },
  { "id": "ep08_v004", "cut": "ep08_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "噛むと息がしやすい？", "synthesis_text": "かむと、いきがしやすい？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v004_ミナ.wav" },
  { "id": "ep08_v005", "cut": "ep08_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "それを一万個発注してます", "synthesis_text": "それを、いちまんこはっちゅうしてます。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v005_タクミ.wav" },
  { "id": "ep08_v006", "cut": "ep08_vc02", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "置けないね", "synthesis_text": "おけないね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v006_ミナ.wav" },
  { "id": "ep08_v007", "cut": "ep08_vc02", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "問題の入口が在庫スペース", "synthesis_text": "もんだいのいりぐちが、ざいこすぺーす。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v007_タクミ.wav" },
  { "id": "ep08_v008", "cut": "ep08_vc03", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "二時十七分。第十三レジが現れた。", "synthesis_text": "にじじゅうななふん。だいじゅうさんれじがあらわれた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v008_ナレーション.wav" },
  { "id": "ep08_v009", "cut": "ep08_vc03", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "月面店発注データを確認。酸素グミ、一万個。銀河標準からあげ、三百本。真空対応ストロー、二千本", "synthesis_text": "げつめんてんはっちゅうでーたをかくにん。さんそぐみ、いちまんこ。ぎんがひょうじゅんからあげ、さんびゃくぼん。しんくうたいおうすとろー、にせんぼん。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v009_第十三レジ.wav" },
  { "id": "ep08_v010", "cut": "ep08_vc03", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "コンビニの発注単位じゃない", "synthesis_text": "こんびにの、はっちゅうたんいじゃない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v010_タクミ.wav" },
  { "id": "ep08_v011", "cut": "ep08_vc04", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田がナビ画面を見ながら言った。", "synthesis_text": "あせだがなびがめんをみながらいった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v011_ナレーション.wav" },
  { "id": "ep08_v012", "cut": "ep08_vc04", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "これは単なる発注ミスではない。補給線の計算だ", "synthesis_text": "これワ、たんなるはっちゅうみすでワない。ほきゅうせんのけいさんだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v012_汗田竜司.wav" },
  { "id": "ep08_v013", "cut": "ep08_vc04", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "補給線？", "synthesis_text": "ほきゅうせん？", "synthesis_source": "reading_hiragana", "pause_after_ms": 250, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v013_タクミ.wav" },
  { "id": "ep08_v014", "cut": "ep08_vc04", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "月面基地の酸素供給が不安定になった時、食料品の名目で酸素を分散配置する。物流最適化の基本だ", "synthesis_text": "げつめんきちのさんそきょうきゅうがふあんていになったとき、しょくりょうひんのめいもくでさんそをぶんさんはいちする。ぶつりゅうさいてきかのきほんだ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v014_汗田竜司.wav" },
  { "id": "ep08_v015", "cut": "ep08_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "タクミは嫌な予感がした。", "synthesis_text": "たくみワ、いやなよかんがした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v015_ナレーション.wav" },
  { "id": "ep08_v016", "cut": "ep08_vc05", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "それ、平和利用なら便利ですけど", "synthesis_text": "それ、へいわりようならべんりですけど。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v016_タクミ.wav" },
  { "id": "ep08_v017", "cut": "ep08_vc05", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はうなずいた。", "synthesis_text": "あせだワ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v017_ナレーション.wav" },
  { "id": "ep08_v018", "cut": "ep08_vc05", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "軍事利用されると、どこへ物資を送れば戦況が変わるかまでわかる", "synthesis_text": "ぐんじりようされると、どこエぶっしをおくればせんきょうがかわるかまでわかる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v018_汗田竜司.wav" },
  { "id": "ep08_v019", "cut": "ep08_vc06", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "危険知識保持者の物流設計と一致率、四十二パーセント", "synthesis_text": "きけんちしきほじしゃのぶつりゅうせっけいと、いっちりつ、よんじゅうにぱーせんと。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v019_第十三レジ.wav" },
  { "id": "ep08_v020", "cut": "ep08_vc06", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "じわじわ上がってません？", "synthesis_text": "じわじわあがってません？", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v020_タクミ.wav" },
  { "id": "ep08_v021", "cut": "ep08_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "発注端末は警告を出す。", "synthesis_text": "はっちゅうたんまつワ、けいこくをだす。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v021_ナレーション.wav" },
  { "id": "ep08_v022", "cut": "ep08_vc07", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "このまま確定すると、三時間後に酸素グミ一万個が現代店舗に納品される。", "synthesis_text": "このまま、かくていすると、さんじかんごにさんそぐみいちまんこがげんだいてんぽにのうひんされる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v022_ナレーション.wav" },
  { "id": "ep08_v023", "cut": "ep08_vc07", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "三列まで", "synthesis_text": "さんれつまで。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v023_ミナ.wav" },
  { "id": "ep08_v024", "cut": "ep08_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "棚割りで宇宙補給を止めるんですか", "synthesis_text": "たなわりで、うちゅうほきゅうをとめるんですか。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v024_タクミ.wav" },
  { "id": "ep08_v025", "cut": "ep08_vc08", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "置けないものは売れない", "synthesis_text": "おけないものワ、うれない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v025_ミナ.wav" },
  { "id": "ep08_v026", "cut": "ep08_vc08", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田はしばらく考え、うなずいた。", "synthesis_text": "あせだワ、しばらくかんがえ、うなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v026_ナレーション.wav" },
  { "id": "ep08_v027", "cut": "ep08_vc08", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "理屈としては正しい。店舗に置ける量を上限条件にすれば、発注最適化が暴走しない", "synthesis_text": "りくつとしてワ、ただしい。てんぽにおけるりょうをじょうげんじょうけんにすれば、はっちゅうさいてきかがぼうそうしない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v027_汗田竜司.wav" },
  { "id": "ep08_v028", "cut": "ep08_vc08", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "コンビニの棚が安全装置になってる", "synthesis_text": "こんびにのたなが、あんぜんそうちになってる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v028_タクミ.wav" },
  { "id": "ep08_v029", "cut": "ep08_vc09", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "そこへ唐沢が入ってきた。", "synthesis_text": "そこエ、からさわがハいってきた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v029_ナレーション.wav" },
  { "id": "ep08_v030", "cut": "ep08_vc09", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "深夜発注、確認します", "synthesis_text": "しんやはっちゅう、かくにんします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v030_唐沢栄治.wav" },
  { "id": "ep08_v031", "cut": "ep08_vc09", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "今それ来ます？", "synthesis_text": "いまそれきます？", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v031_タクミ.wav" },
  { "id": "ep08_v032", "cut": "ep08_vc10", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は画面を見た。", "synthesis_text": "からさわワ、がめんをみた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v032_ナレーション.wav" },
  { "id": "ep08_v033", "cut": "ep08_vc10", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "酸素グミ一万個。発注過多です。三列展開なら、最大二十四個", "synthesis_text": "さんそぐみいちまんこ。はっちゅうかたです。さんれつてんかいなら、さいだいにじゅうよんこ。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v033_唐沢栄治.wav" },
  { "id": "ep08_v034", "cut": "ep08_vc10", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "唐沢さんが現実の数字で宇宙を殴ってる", "synthesis_text": "からさわさんが、げんじつのすうじでうちゅうをなぐってる。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v034_タクミ.wav" },
  { "id": "ep08_v035", "cut": "ep08_vc11", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "棚割り上限を受理。発注数を二十四個へ補正します", "synthesis_text": "たなわりじょうげんをじゅり。はっちゅうすうを、にじゅうよんこエほせいします。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v035_第十三レジ.wav" },
  { "id": "ep08_v036", "cut": "ep08_vc12", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "月面店から通信が入った。画面には無人の店内が映る。棚の端で、酸素グミのキャラクターが悲しそうに揺れている。", "synthesis_text": "げつめんてんからつうしんがハいった。がめんにワ、むじんのてんないがうつる。たなのはしで、さんそぐみのきゃらくたーがかなしそうにゆれている。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v036_ナレーション.wav" },
  { "id": "ep08_v037", "cut": "ep08_vc12", "character": "月面店システム", "speaker_name": "桜音", "style_name": "ノーマル", "style_id": 376644064, "text": "一万個ないと不安です", "synthesis_text": "いちまんこないと、ふあんです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v037_月面店システム.wav" },
  { "id": "ep08_v038", "cut": "ep08_vc12", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "三列まで", "synthesis_text": "さんれつまで。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v038_ミナ.wav" },
  { "id": "ep08_v039", "cut": "ep08_vc12", "character": "月面店システム", "speaker_name": "桜音", "style_name": "ノーマル", "style_id": 376644064, "text": "了解しました", "synthesis_text": "りょうかいしました。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v039_月面店システム.wav" },
  { "id": "ep08_v040", "cut": "ep08_vc12", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "素直！", "synthesis_text": "すなお！", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v040_タクミ.wav" },
  { "id": "ep08_v041", "cut": "ep08_vc13", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "汗田は言った。", "synthesis_text": "あせだワ、いった。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v041_ナレーション.wav" },
  { "id": "ep08_v042", "cut": "ep08_vc13", "character": "汗田竜司", "speaker_name": "阿井田 茂", "style_name": "ノーマル", "style_id": 1310138976, "text": "不安を在庫で埋めようとすると、物流は簡単に暴走する。必要量を決めるのは、案外、人間の棚感覚かもしれない", "synthesis_text": "ふあんをざいこでうめようとすると、ぶつりゅうワかんたんにぼうそうする。ひつようりょうをきめるのワ、あんがい、にんげんのたなかんかくかもしれない。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v042_汗田竜司.wav" },
  { "id": "ep08_v043", "cut": "ep08_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナは二十四個の仮発注を確定した。", "synthesis_text": "みなワ、にじゅうよんこのかりはっちゅうをかくていした。", "synthesis_source": "reading_hiragana", "pause_after_ms": 350, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v043_ナレーション.wav" },
  { "id": "ep08_v044", "cut": "ep08_vc14", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "第十三レジのレシートが出た。", "synthesis_text": "だいじゅうさんれじのれしーとがでた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v044_ナレーション.wav" },
  { "id": "ep08_v045", "cut": "ep08_vc15", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢は満足げにうなずいた。", "synthesis_text": "からさわワ、まんぞくげにうなずいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v045_ナレーション.wav" },
  { "id": "ep08_v046", "cut": "ep08_vc15", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "深夜帯の特殊レジ施策としては、売場連動が弱いですね", "synthesis_text": "しんやたいのとくしゅれじしさくとしてワ、うりばれんどうがよわいですね。", "synthesis_source": "reading_hiragana", "pause_after_ms": 400, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v046_唐沢栄治.wav" },
  { "id": "ep08_v047", "cut": "ep08_vc15", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "特殊レジ施策じゃないです", "synthesis_text": "とくしゅれじしさくじゃないです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v047_タクミ.wav" },
  { "id": "ep08_v048", "cut": "ep08_vc15", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "あと、第十三レジの回転率が悪いです", "synthesis_text": "あと、だいじゅうさんれじのかいてんりつがわるいです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v048_唐沢栄治.wav" },
  { "id": "ep08_v049", "cut": "ep08_vc15", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "時空処理してるんですよ！", "synthesis_text": "じくうしょりしてるんですよ！", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v049_タクミ.wav" },
  { "id": "ep08_v050", "cut": "ep08_vc15", "character": "唐沢栄治", "speaker_name": "M1", "style_name": "ノーマル", "style_id": 2051283136, "text": "でも一会計三分以内で", "synthesis_text": "でも、いちかいけいさんぷんいないで。", "synthesis_source": "reading_hiragana", "pause_after_ms": 450, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v050_唐沢栄治.wav" },
  { "id": "ep08_v051", "cut": "ep08_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "唐沢が帰ったあと、タクミはマニュアルに書いた。", "synthesis_text": "からさわがかえったあと、たくみワ、まにゅあるにかいた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v051_ナレーション.wav" },
  { "id": "ep08_v052", "cut": "ep08_vc16", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "置けないものは売れない。発注数は不安で決めない。棚割りは補給線より強い場合がある。", "synthesis_text": "おけないものワ、うれない。はっちゅうすうワ、ふあんできめない。たなわりワ、ほきゅうせんよりつよいばあいがある。", "synthesis_source": "reading_hiragana", "pause_after_ms": 500, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v052_ナレーション.wav" },
  { "id": "ep08_v053", "cut": "ep08_vc17", "character": "ナレーション", "speaker_name": "澤原 玄二郎", "style_name": "ノーマル", "style_id": 2029042368, "text": "ミナはホットスナックケースを閉めた。", "synthesis_text": "みなワ、ほっとすなっくけーすをしめた。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v053_ナレーション.wav" },
  { "id": "ep08_v054", "cut": "ep08_vc17", "character": "ミナ", "speaker_name": "中2", "style_name": "ノーマル", "style_id": 604166016, "text": "酸素グミ、味は？", "synthesis_text": "さんそぐみ、あじワ？", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v054_ミナ.wav" },
  { "id": "ep08_v055", "cut": "ep08_vc17", "character": "第十三レジ", "speaker_name": "ろてじん（匿名インタビュー風）", "style_name": "ノーマル", "style_id": 1805828384, "text": "空気味です", "synthesis_text": "くうきあじです。", "synthesis_source": "reading_hiragana", "pause_after_ms": 300, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v055_第十三レジ.wav" },
  { "id": "ep08_v056", "cut": "ep08_vc17", "character": "タクミ", "speaker_name": "にせ", "style_name": "ノーマル", "style_id": 1937616896, "text": "嫌な予想通り", "synthesis_text": "いやなよそうどおり。", "synthesis_source": "reading_hiragana", "pause_after_ms": 800, "clip": "outputs\\ep08_voice_reading_hiragana\\clips\\ep08_v056_タクミ.wav" }
]
